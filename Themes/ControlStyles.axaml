<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    NullWave Control Styles
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    All StaticResource keys are defined in:
      Themes/Colors.axaml     → brushes and colors
      Themes/Typography.axaml → font sizes
      Themes/Shapes.axaml     → radii and spacing

    Button classes:
      .nav        - sidebar navigation item
      .nav.active - currently selected nav item
      .icon-btn   - borderless icon button (player controls, gear, etc.)
      .primary    - accent-filled action button
      .secondary  - container-colored secondary button
      .ghost      - border-only ghost button
      .danger     - destructive actions
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  -->

  <!-- ═══════════════════════════════════════════════════════════════════════
       DANGER BUTTON  - destructive actions (remove, delete, wipe)
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.danger">
    <Setter Property="Background"   Value="{StaticResource BrushRedDim}"/>
    <Setter Property="Foreground"   Value="{StaticResource BrushRed}"/>
    <Setter Property="BorderBrush"  Value="{StaticResource BrushRed}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize"     Value="{StaticResource FontSizeBodyLarge}"/>
    <Setter Property="FontWeight"   Value="Medium"/>
    <Setter Property="Padding"      Value="18,9"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Cursor"       Value="Hand"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushRed}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       GLOBAL TEXT DEFAULTS
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECTION LABEL  - tiny all-caps category headers in sidebar
       Usage: <TextBlock Classes="section-label" Text="LIBRARY"/>
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock.section-label">
    <Setter Property="Foreground"     Value="{StaticResource BrushTextMuted}"/>
    <Setter Property="FontSize"       Value="{StaticResource FontSizeLabel}"/>
    <Setter Property="FontWeight"     Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="2"/>
    <Setter Property="Margin"         Value="4,24,0,12"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       NAV BUTTON
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.nav">
    <Setter Property="Background"                 Value="Transparent"/>
    <Setter Property="Foreground"                 Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="FontSize"                   Value="{StaticResource FontSizeBodyLarge}"/>
    <Setter Property="Padding"                    Value="12,8"/>
    <Setter Property="CornerRadius"               Value="{StaticResource RadiusMd}"/>
    <Setter Property="HorizontalAlignment"        Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Margin"                     Value="4,1"/>
    <Setter Property="Cursor"                     Value="Hand"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ICON BUTTON  - borderless square icon buttons (Standard 32x32)
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"      Value="0"/>
    <Setter Property="Width"        Value="32"/>
    <Setter Property="Height"       Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="FontSize"     Value="16"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Cursor"       Value="Hand"/>
  </Style>
  <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
  </Style>
  <Style Selector="Button.icon-btn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
  </Style>

  <!-- Dense variant for tight spaces like track rows (24x24) -->
  <Style Selector="Button.icon-btn.sm">
    <Setter Property="Width"        Value="24"/>
    <Setter Property="Height"       Value="24"/>
    <Setter Property="FontSize"     Value="12"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       PLAYER BUTTON  - Spotify-style: no border, no background box
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.player-btn">
    <Setter Property="Background"              Value="Transparent"/>
    <Setter Property="Foreground"              Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="Padding"                 Value="0"/>
    <Setter Property="Width"                   Value="32"/>
    <Setter Property="Height"                  Value="32"/>
    <Setter Property="CornerRadius"            Value="{StaticResource RadiusFull}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Cursor"                  Value="Hand"/>
    <Setter Property="FontSize"                Value="16"/>
  </Style>
  <Style Selector="Button.player-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{StaticResource BrushTextPrimary}"/>
  </Style>
  <Style Selector="Button.player-btn:pressed /template/ ContentPresenter">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{StaticResource BrushAccentHover}"/>
  </Style>

  <Style Selector="Button.player-btn.play">
    <Setter Property="Background"  Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="Foreground"  Value="{StaticResource BrushBase}"/>
    <Setter Property="Width"       Value="40"/>
    <Setter Property="Height"      Value="40"/>
    <Setter Property="FontSize"    Value="18"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
  </Style>
  <Style Selector="Button.player-btn.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background"  Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="Foreground"  Value="{StaticResource BrushBase}"/>
  </Style>

  <Style Selector="Button.player-btn.active">
    <Setter Property="Foreground"  Value="{StaticResource BrushAccent}"/>
  </Style>
  <Style Selector="Button.player-btn.active:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground"  Value="{StaticResource BrushAccentHover}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       PRIMARY BUTTON  - accent-filled
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.primary">
    <Setter Property="Background"   Value="{StaticResource BrushAccent}"/>
    <Setter Property="Foreground"   Value="White"/>
    <Setter Property="FontSize"     Value="{StaticResource FontSizeBody}"/>
    <Setter Property="FontWeight"   Value="SemiBold"/>
    <Setter Property="Padding"      Value="16,8"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Cursor"       Value="Hand"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECONDARY BUTTON  - container-colored, dark-mode friendly
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.secondary">
    <Setter Property="Background"   Value="{StaticResource BrushSurface2}"/>
    <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="BorderBrush"  Value="{StaticResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize"     Value="{StaticResource FontSizeBody}"/>
    <Setter Property="FontWeight"   Value="Medium"/>
    <Setter Property="Padding"      Value="16,8"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Cursor"       Value="Hand"/>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSub}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       GHOST BUTTON  - border only
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Button.ghost">
    <Setter Property="Background"        Value="Transparent"/>
    <Setter Property="Foreground"        Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="BorderBrush"       Value="{StaticResource BrushBorderSub}"/>
    <Setter Property="BorderThickness"   Value="1"/>
    <Setter Property="FontSize"          Value="{StaticResource FontSizeBody}"/>
    <Setter Property="Padding"           Value="14,7"/>
    <Setter Property="CornerRadius"      Value="{StaticResource RadiusMd}"/>
    <Setter Property="Cursor"            Value="Hand"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       LISTBOX + LISTBOXITEM
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding"    Value="0"/>
  </Style>
  <Style Selector="ListBoxItem">
      <Setter Property="Background"   Value="Transparent"/>
      <Setter Property="Padding"      Value="0"/>
      <Setter Property="Margin"       Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Opacity"      Value="1"/>
      <Setter Property="Transitions">
          <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
          </Transitions>
      </Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       DRAG-AND-DROP LIST ROW  - shared across Sidebar nav items and Queue tracks
       Usage: add Classes="draggable-row" to the row container (Border or Grid).
       Toggle "dragging"/"drop-target" classes (via binding or code-behind) to
       trigger the fade/highlight below.
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.draggable-row">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.draggable-row.dragging">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <Style Selector="Border.draggable-row.drop-target">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
  </Style>

  <Style Selector="Grid.draggable-row">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.draggable-row.drop-target">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SLIDE-IN PANEL HEADER  - shared across Track Detail, Queue, and any
       future right-side panel. Usage: StackPanel Classes="panel-header" wraps
       the title Grid; TextBlock Classes="panel-title" for the heading;
       Separator Classes="panel-header-sep" as the divider beneath.
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="StackPanel.panel-header">
    <Setter Property="Spacing" Value="0"/>
    <Setter Property="Margin" Value="16,16,16,0"/>
  </Style>
  <Style Selector="TextBlock.panel-title">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Separator.panel-header-sep">
    <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       TEXT INPUT
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBox">
    <Setter Property="Background"        Value="{StaticResource BrushSurface2}"/>
    <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="BorderBrush"       Value="{StaticResource BrushBorder}"/>
    <Setter Property="BorderThickness"   Value="1"/>
    <Setter Property="CornerRadius"      Value="{StaticResource RadiusMd}"/>
    <Setter Property="FontSize"          Value="{StaticResource FontSizeBody}"/>
    <Setter Property="Padding"           Value="10,7"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border">
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       PROGRESS BAR
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground"    Value="{StaticResource BrushAccent}"/>
    <Setter Property="Background"    Value="{StaticResource BrushBorder}"/>
    <Setter Property="CornerRadius"  Value="{StaticResource RadiusFull}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SLIDER
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Slider /template/ Track /template/ Border#TrackBackground">
    <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
  </Style>
  <Style Selector="Slider /template/ Track /template/ Border#TrackForeground">
    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       COMBOBOX
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="ComboBox">
    <Setter Property="Background"      Value="{StaticResource BrushSurface2}"/>
    <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
    <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
    <Setter Property="Padding"         Value="10,7"/>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#border">
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="Padding"    Value="10,6"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       TAB CONTROL
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="TabItem">
    <Setter Property="Background"        Value="Transparent"/>
    <Setter Property="Foreground"        Value="{StaticResource BrushTextMuted}"/>
    <Setter Property="FontSize"          Value="{StaticResource FontSizeBody}"/>
    <Setter Property="Padding"           Value="16,10"/>
    <Setter Property="BorderThickness"   Value="0"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
    <Setter Property="BorderBrush"       Value="{StaticResource BrushAccent}"/>
    <Setter Property="BorderThickness"   Value="0,0,0,2"/>
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background"        Value="{StaticResource BrushElevated}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       UNIFIED TOGGLE SWITCH STYLE
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="SwitchTrack"
                Width="44" Height="24"
                CornerRadius="12"
                Background="{StaticResource BrushSurface2}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          
          <Panel>
            <Panel x:Name="PART_MovingKnobs"/>
            <Border x:Name="SwitchKnob"
                    Width="14" Height="14"
                    CornerRadius="7"
                    Background="{StaticResource BrushTextSecondary}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0">
              <Border.Transitions>
                <Transitions>
                  <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                  <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
              </Border.Transitions>
            </Border>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnob">
    <Setter Property="Margin" Value="26,0,0,0"/>
    <Setter Property="Background" Value="{StaticResource BrushBase}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SETTINGS CARD, ROW BREAKS, AND INFO BANNERS
       ═══════════════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
  </Style>

  <Style Selector="Border.settings-banner">
    <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSub}"/>
    <Setter Property="BorderThickness" Value="1,1,1,1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,4,0,16"/>
  </Style>

  <Style Selector="Border.separator">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
    <Setter Property="Margin" Value="0,14"/>
  </Style>

  <Style Selector="Button.help-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.help-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
  </Style>

  <Style Selector="Border.BottomSpacer">
    <Setter Property="Height" Value="80"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

</Styles>