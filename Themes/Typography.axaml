<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Corner radii -->
  <CornerRadius x:Key="RadiusXs">   2</CornerRadius>
  <CornerRadius x:Key="RadiusSm">   4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">   6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">  10</CornerRadius>
  <CornerRadius x:Key="RadiusXl">  14</CornerRadius>
  <CornerRadius x:Key="RadiusFull">9999</CornerRadius>
  <CornerRadius x:Key="RadiusArt">   6</CornerRadius>

  <!-- Spacing -->
  <x:Double x:Key="Space1">  4</x:Double>
  <x:Double x:Key="Space2">  8</x:Double>
  <x:Double x:Key="Space3"> 12</x:Double>
  <x:Double x:Key="Space4"> 16</x:Double>
  <x:Double x:Key="Space5"> 20</x:Double>
  <x:Double x:Key="Space6"> 24</x:Double>

  <!-- Layout dimensions (single source of truth) -->
  <x:Double x:Key="SidebarWidth">210</x:Double>
  <x:Double x:Key="MiniPlayerHeight">90</x:Double>
  <x:Double x:Key="DetailPanelWidth">320</x:Double>

  <!-- Track row density (rewritten at runtime by ThemeService) -->
  <x:Double x:Key="TrackRowHeight">44</x:Double>
  <x:Double x:Key="RowArtSize">40</x:Double>

  <!-- Avatar sizes -->
  <x:Double x:Key="AvatarSm">32</x:Double>
  <x:Double x:Key="AvatarMd">44</x:Double>
  <x:Double x:Key="AvatarLg">64</x:Double>

</ResourceDictionary>