<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    TYPOGRAPHY TOKENS (single source of truth for font sizes only)
    Radii, spacing, layout, margins and avatar sizes live in Shapes.axaml.
    ThemeService.ApplyFontScale rewrites these at runtime when the user picks
    Small/Medium/Large - so XAML references survive with correct base values.
  -->

  <!-- Body scale (Xs..3xl) -->
  <x:Double x:Key="FontSizeXs">11</x:Double>
  <x:Double x:Key="FontSizeSm">12</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeMd">15</x:Double>
  <x:Double x:Key="FontSizeLg">17</x:Double>
  <x:Double x:Key="FontSizeXl">20</x:Double>
  <x:Double x:Key="FontSize2xl">24</x:Double>
  <x:Double x:Key="FontSize3xl">30</x:Double>

  <!-- Semantic aliases (set by ThemeService; base values here for static XAML refs) -->
  <x:Double x:Key="FontSizeLabel">11</x:Double>
  <x:Double x:Key="FontSizeBodyLarge">15</x:Double>
  <x:Double x:Key="FontSizeSubtitle">17</x:Double>
  <x:Double x:Key="FontSizeTitle">20</x:Double>
  <x:Double x:Key="FontSizeHeading">24</x:Double>

</ResourceDictionary>