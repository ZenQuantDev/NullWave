<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NullWave.Helpers.Localization"
        x:Class="NullWave.Views.CreatePlaylistDialog"
        Title="{loc:Loc Dialog_CreatePlaylist_Title}"
        Width="360" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBase}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="{loc:Loc Dialog_Cancel}"
                    Click="OnCancel"
                    Classes="secondary"
                    Padding="16,8"/>
            <Button Content="{loc:Loc Dialog_Create}"
                    Click="OnCreate"
                    Classes="primary"
                    Padding="16,8"/>
        </StackPanel>

        <StackPanel Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{loc:Loc Dialog_CreatePlaylist_NameLabel}"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="{DynamicResource FontSizeBody}"/>
            <TextBox Name="NameInput"
                     PlaceholderText="{loc:Loc Dialog_CreatePlaylist_NamePlaceholder}"
                     KeyDown="OnNameInputKeyDown"/>
        </StackPanel>
    </DockPanel>
</Window>