<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels.Dialogs"
        xmlns:loc="using:NullWave.Helpers.Localization"
        x:Class="NullWave.Views.Dialogs.DownloaderConsentView"
        x:DataType="vm:DownloaderConsentViewModel"
        Title="{loc:Loc DownloaderConsent_Title}"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="{loc:Loc DownloaderConsent_Decline}" Command="{Binding DeclineCommand}" Classes="ghost"/>
            <Button Content="{loc:Loc DownloaderConsent_Accept}" Command="{Binding AcceptCommand}" Classes="primary"
                    IsEnabled="{Binding CanAccept}"/>
        </StackPanel>
        
        <ScrollViewer>
            <StackPanel Spacing="16">
                <TextBlock Text="{loc:Loc DownloaderConsent_Heading}" Classes="Heading"/>
                
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{loc:Loc DownloaderConsent_Intro}"/>
                </TextBlock>

                <Border Background="{StaticResource BrushAmberDim}" BorderBrush="{StaticResource BrushAmber}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc DownloaderConsent_Responsibility_Title}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="{loc:Loc DownloaderConsent_Responsibility_Desc}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc DownloaderConsent_Feature_Title}" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{loc:Loc DownloaderConsent_Feature_Desc}"/>
                </TextBlock>

                <CheckBox IsChecked="{Binding UserUnderstands}" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc DownloaderConsent_Understand}"/>
                    </TextBlock>
                </CheckBox>

                <CheckBox IsChecked="{Binding UserAcceptsResponsibility}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc DownloaderConsent_AcceptResponsibility}"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>