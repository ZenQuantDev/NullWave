<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:models="using:NullWave.Models"
        xmlns:helpers="using:NullWave.Helpers"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="NullWave.Views.Controls.SidebarView"
        x:DataType="vm:MainViewModel"
        Background="{StaticResource BrushSurface}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="0,0,1,0">

    <DockPanel>

        <!-- App logo -->
        <Border DockPanel.Dock="Top" Padding="16,20,16,12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="32" Height="32"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{StaticResource BrushAccentDim}"
                        ClipToBounds="True">
                    <TextBlock Text="N"
                               Foreground="{StaticResource BrushAccent}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="NullWave"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeXl}"
                               FontWeight="Bold"/>
                    <TextBlock Text="music organizer"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="1"
                Background="{StaticResource BrushBorder}"
                Margin="12,0"/>

        <!-- Profile bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BrushBase}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Profile Button -->
                <Button Grid.Column="0"
                        Command="{Binding OpenProfileCommand}"
                        HorizontalContentAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
                        </Style>
                    </Button.Styles>

                    <Grid ColumnDefinitions="40,8,*,Auto" Margin="8,4">
                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="{StaticResource RadiusFull}"
                                Background="{StaticResource BrushAccentDim}"
                                ClipToBounds="True">
                            <Panel>
                                <Image Source="{Binding Profile.Avatar}"
                                    IsVisible="{Binding Profile.HasAvatar}"
                                    Stretch="UniformToFill"/>
                                <material:MaterialIcon Kind="MusicNote"
                                        IsVisible="{Binding !Profile.HasAvatar}"
                                        Foreground="{StaticResource BrushAccent}"
                                        Width="18" Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Panel>
                        </Border>

                        <!-- Username + subtitle -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="{Binding Profile.Username}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    FontSize="{StaticResource FontSizeMd}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Profile.Bio}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    FontSize="{StaticResource FontSizeXs}"
                                    TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Chevron indicator -->
                        <material:MaterialIcon Grid.Column="3"
                                Kind="ChevronRight"
                                Foreground="{StaticResource BrushTextMuted}"
                                Width="20" Height="20"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"/>
                    </Grid>
                </Button>

                <!-- Settings gear button -->
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Settings"
                        Command="{Binding OpenSettingsCommand}">
                    <material:MaterialIcon Kind="Cog" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Track count -->
        <Border DockPanel.Dock="Bottom" Padding="16,6">
            <TextBlock Text="{Binding Library.Tracks.Count, StringFormat='{}{0} tracks'}"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="{StaticResource FontSizeSm}"/>
        </Border>

        <!-- Nav list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="8,4">
            <StackPanel Spacing="0">
                
                <!-- DATA-DRIVEN LIBRARY SECTION -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,12">
                    <TextBlock Grid.Column="0" Classes="section-label" Text="LIBRARY" Margin="0"/>
                    <Button Grid.Column="1" Classes="icon-btn sm"
                            Command="{Binding ToggleCustomizeSidebarCommand}"
                            ToolTip.Tip="Reorder nav items"
                            VerticalAlignment="Center">
                        <material:MaterialIcon Kind="Pencil" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Nav.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NavItem">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Button Grid.Column="0"
                                        Classes="nav"
                                        Classes.active="{Binding IsActive}"
                                        Content="{Binding Label}"
                                        Command="{Binding Command}"/>
                                <Button Grid.Column="1" Classes="icon-btn sm"
                                        Command="{Binding $parent[ItemsControl].DataContext.Nav.MoveUpCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding $parent[ItemsControl].DataContext.IsCustomizingSidebar}"
                                        ToolTip.Tip="Move up">
                                    <material:MaterialIcon Kind="MenuUp" Width="14" Height="14"/>
                                </Button>
                                <Button Grid.Column="2" Classes="icon-btn sm"
                                        Command="{Binding $parent[ItemsControl].DataContext.Nav.MoveDownCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding $parent[ItemsControl].DataContext.IsCustomizingSidebar}"
                                        ToolTip.Tip="Move down">
                                    <material:MaterialIcon Kind="MenuDown" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- UNTOUCHED FILTERS & SOURCES SECTIONS -->
                <TextBlock Classes="section-label" Text="FILTERS" Margin="4,12,0,0"/>
                <Button x:Name="FavBtn"    Classes="nav" Content="Favorites"      Command="{Binding Library.ShowFavoritesCommand}"/>
                <Button x:Name="RecentBtn" Classes="nav" Content="Recently Added" Command="{Binding Library.ShowRecentCommand}"/>

                <TextBlock Classes="section-label" Text="SOURCES" Margin="4,12,0,0"/>
                <Button x:Name="YTBtn"    Classes="nav" Content="YouTube"     Command="{Binding Library.FilterYouTubeCommand}"/>
                <Button x:Name="LFMBtn"   Classes="nav" Content="Last.fm"     Command="{Binding Library.FilterLastFmCommand}"/>
                <Button x:Name="SCBtn"    Classes="nav" Content="SoundCloud"  Command="{Binding Library.FilterSoundCloudCommand}"/>
                <Button x:Name="LocalBtn" Classes="nav" Content="Local Files" Command="{Binding Library.FilterLocalCommand}"/>
                
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Border>