<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:models="using:NullWave.Models"
        xmlns:helpers="using:NullWave.Helpers"
        xmlns:services="using:NullWave.Services"
        xmlns:sys="using:System"
        xmlns:attached="using:NullWave.Helpers.Attached"
        xmlns:converters="using:NullWave.Helpers.Converters"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:controls="using:NullWave.Views.Controls"
        xmlns:loc="using:NullWave.Helpers.Localization"
        x:Class="NullWave.Views.Controls.SidebarView"
        x:DataType="vm:MainViewModel"
        Background="{StaticResource BrushSurface}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="0,0,1,0"
        Width="{Binding SidebarWidth}"
        ClipToBounds="True"
        Classes.collapsed="{Binding !IsSidebarExpanded}"
        PointerMoved="OnRowDragPointerMoved"
        PointerReleased="OnRowDragPointerReleased">
    <Border.Transitions>
        <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="QuadraticEaseOut"/>
        </Transitions>
    </Border.Transitions>
    <Border.Resources>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <converters:BoolToRotateTransformConverter x:Key="BoolToRotate"/>
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
        <converters:BoolToBrushConverter x:Key="StarBrush" TrueBrush="{StaticResource BrushStarOn}" FalseBrush="{StaticResource BrushStarOff}"/>
        <converters:GuidEqualsConverter x:Key="GuidEquals"/>
        <converters:BoolNegationConverter x:Key="BoolNegation"/>

        <DataTemplate x:Key="PlaylistRowTemplate" x:DataType="models:Playlist">
            <Border Classes="playlist-row" Tag="{Binding}"
                    DoubleTapped="OnPlaylistRowDoubleTapped"
                    Cursor="Hand">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc ContextMenu_Play}" Click="OnPlaylistMenuPlay"/>
                        <MenuItem Header="{loc:Loc ContextMenu_AddToQueue}" Click="OnPlaylistMenuQueue"/>
                        <MenuItem Header="{loc:Loc ContextMenu_MoveToFolder}" Click="OnPlaylistMenuMoveToFolder"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc ContextMenu_PinToSidebar}" Click="OnPlaylistMenuPin"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <attached:PseudoClass.Active>
                    <MultiBinding Converter="{StaticResource GuidEquals}">
                        <Binding Path="$parent[controls:SidebarView].DataContext(vm:MainViewModel).Playlist.SelectedPlaylist.Id" FallbackValue="{x:Static sys:Guid.Empty}"/>
                        <Binding Path="Id"/>
                    </MultiBinding>
                </attached:PseudoClass.Active>
                
                <Grid>
                    <!-- FIX: ToolTip.ShowDelay expects an int (milliseconds), not a TimeSpan string -->
                    <Button Classes="nav sidebar-nav"
                            Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).NavigateToPlaylistCommand}"
                            CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                        <ToolTip.Tip>
                            <Border Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" 
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12,10" MinWidth="180">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" 
                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Tracks.Count}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                        <TextBlock Text="{loc:Loc Sidebar_Label_Tracks}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ToolTip.Tip>
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Classes="art-tile"
                                    Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}"
                                    Margin="0,0,10,0" CornerRadius="{StaticResource RadiusSm}"
                                    Background="{StaticResource BrushAccentDim}" ClipToBounds="True">
                                <Panel>
                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                            IsVisible="{Binding ArtPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Border.Background>
                                            <ImageBrush Source="{Binding ArtPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <material:MaterialIcon Kind="PlaylistMusic" Width="20" Height="20" Foreground="{StaticResource BrushAccent}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding ArtPath, Converter={x:Static ObjectConverters.IsNull}}"/>
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                                        IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsSidebarExpanded}">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Tracks.Count}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                    <TextBlock Text="{loc:Loc Sidebar_Label_Tracks}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsSidebarExpanded}">
                        <Button Classes="sidebar-action" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_PlayAll}"
                                Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).PlayPlaylistCommand}" CommandParameter="{Binding}">
                            <material:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="{StaticResource BrushAccent}"/>
                        </Button>
                        <Button Classes="sidebar-action" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Pin}"
                                Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.PinPlaylistCommand}" CommandParameter="{Binding}">
                            <material:MaterialIcon Kind="PinOutline" Width="16" Height="16" Foreground="{StaticResource BrushTextMuted}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FolderChildRowTemplate" x:DataType="models:Playlist">
            <Grid ColumnDefinitions="20,*">
                <Border Grid.Column="0" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        Background="{StaticResource BrushBorder}"/>
                <Border Grid.Column="0" Height="1" Width="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource BrushBorder}"/>
                <ContentControl Grid.Column="1" Content="{Binding}"
                                ContentTemplate="{StaticResource PlaylistRowTemplate}"/>
            </Grid>
        </DataTemplate>
    </Border.Resources>

    <Border.Styles>
        <Style Selector="Border.art-tile">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
        </Style>
        <Style Selector="Button.sidebar-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions></Setter>
        </Style>
        <Style Selector="Border.playlist-row:pointerover Button.sidebar-action"><Setter Property="Opacity" Value="1"/></Style>
        <Style Selector="Border.playlist-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions></Setter>
        </Style>
        <Style Selector="Border.playlist-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        </Style>
        <Style Selector="Border.playlist-row.active">
            <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.playlist-row.drop-target">
            <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.playlist-row.dragging">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Border.collapsed ScrollViewer">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="Border.collapsed Border.playlist-row">
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style Selector="Border.collapsed Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.collapsed Button.nav Border.art-tile">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style Selector="Border.collapsed Border.active-bar">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        
        <!-- Tooltips ONLY in collapsed rail mode: when expanded, the labels are
             already visible, so a hover box is redundant noise. -->
        <Style Selector="Button.nav">
            <Setter Property="ToolTip.ShowDelay" Value="3600000"/>
        </Style>
        <Style Selector="Border.collapsed Button.nav">
            <Setter Property="ToolTip.ShowDelay" Value="200"/>
        </Style>
    </Border.Styles>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,16,12,12">
            <Panel>
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSidebarExpanded}">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" BoxShadow="0 3 10 0 #55000000"
                            Background="{StaticResource BrushAccentGradient}">
                        <material:MaterialIcon Kind="Waveform" Foreground="White" Width="24" Height="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="NullWave" Margin="12,0,0,0"
                               Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeXl}"
                               FontWeight="Black" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="icon-btn" Command="{Binding ToggleSidebarCollapsedCommand}"
                            ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Collapse}" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>
                </Grid>
                <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        Command="{Binding ToggleSidebarCollapsedCommand}" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Expand}"
                        IsVisible="{Binding !IsSidebarExpanded}">
                    <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" BoxShadow="0 3 10 0 #55000000"
                            Background="{StaticResource BrushAccentGradient}">
                        <material:MaterialIcon Kind="Waveform" Foreground="White" Width="24" Height="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Panel>
        </Border>

        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BrushBorder}" Margin="12,0,12,8"/>

        <!-- Bottom: profile / rail -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBase}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="8,6,8,10">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                            IsVisible="{Binding IsSidebarExpanded}">
                    <TextBlock Text="{Binding Library.Tracks.Count}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                    <TextBlock Text="{loc:Loc Sidebar_Label_Tracks}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                </StackPanel>
                <Panel>
                    <Grid IsVisible="{Binding IsSidebarExpanded}" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" Command="{Binding OpenProfileCommand}" HorizontalContentAlignment="Stretch"
                                Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
                                </Style>
                            </Button.Styles>
                            <Grid ColumnDefinitions="40,8,*" Margin="8,4">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusFull}"
                                        Background="{StaticResource BrushAccentDim}" ClipToBounds="True"
                                        BorderBrush="{StaticResource BrushAccent}"
                                        BorderThickness="{Binding Source={x:Static services:ThemeService.Instance}, Path=AvatarFrameThickness}"
                                        BoxShadow="0 2 6 0 #40000000">
                                    <Panel>
                                        <Image Source="{Binding Profile.Avatar}"
                                               IsVisible="{Binding Profile.HasAvatar}" Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <material:MaterialIcon Kind="Account" IsVisible="{Binding !Profile.HasAvatar}"
                                                               Foreground="{StaticResource BrushAccent}" Width="20" Height="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Profile.Username}" Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Profile.Bio}" Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeXs}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="icon-btn" VerticalAlignment="Center" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Settings}"
                                Command="{Binding OpenSettingsCommand}" Margin="4,0,0,0">
                            <material:MaterialIcon Kind="Cog" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                    <StackPanel IsVisible="{Binding !IsSidebarExpanded}" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="icon-btn" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Settings}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Center">
                            <material:MaterialIcon Kind="Cog" Width="20" Height="20"/>
                        </Button>
                        <Button ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Profile}" Command="{Binding OpenProfileCommand}"
                                Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource BrushAccentDim}" ClipToBounds="True"
                                    BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="{Binding Source={x:Static services:ThemeService.Instance}, Path=AvatarFrameThickness}"
                                    BoxShadow="0 2 6 0 #40000000">
                                <Panel>
                                    <Image Source="{Binding Profile.Avatar}"
                                           IsVisible="{Binding Profile.HasAvatar}" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <material:MaterialIcon Kind="Account" IsVisible="{Binding !Profile.HasAvatar}"
                                                           Foreground="{StaticResource BrushAccent}" Width="18" Height="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Border>
                        </Button>
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4,10,4">
            <StackPanel Spacing="0">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,4,12" IsVisible="{Binding IsSidebarExpanded}">
                    <TextBlock Grid.Column="0" Classes="section-label" Text="{loc:Loc Sidebar_Section_YourLibrary}" Margin="0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon-btn" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_CreateNew}" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop">
                                <StackPanel Spacing="2" MinWidth="170">
                                    <TextBlock Classes="section-label" Text="{loc:Loc Sidebar_Section_CreateNew}" Margin="4,2,4,4"/>
                                    <Button Classes="flyout-item" Command="{Binding Playlist.CreatePlaylistCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <material:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18" Foreground="{StaticResource BrushAccent}"/>
                                            <TextBlock Text="{loc:Loc Sidebar_Menu_Playlist}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="flyout-item" Command="{Binding Playlist.CreateFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <material:MaterialIcon Kind="Folder" Width="18" Height="18" Foreground="{StaticResource BrushAmber}"/>
                                            <TextBlock Text="{loc:Loc Sidebar_Menu_Folder}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="2" Classes="icon-btn" Command="{Binding ToggleCustomizeSidebarCommand}"
                            ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Reorder}" VerticalAlignment="Center" Margin="2,0,0,0">
                        <material:MaterialIcon Kind="{Binding IsCustomizingSidebar, Converter={StaticResource BoolToIconKind}, ConverterParameter='Check, Pencil'}" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Nav.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NavItem">
                            <Border Classes="playlist-row" Classes.active="{Binding IsActive}"
                                    Classes.dragging="{Binding IsDragging}"
                                    Classes.drop-target="{Binding IsDropTarget}"
                                    Tag="{Binding}"
                                    DoubleTapped="OnNavItemDoubleTapped"
                                    PointerPressed="OnRowDragPointerPressed"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragEnter="OnNavItemDragEnter"
                                    DragDrop.DragLeave="OnNavItemDragLeave"
                                    DragDrop.Drop="OnNavItemDrop"
                                    Cursor="Hand">

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc ContextMenu_Play}" Click="OnNavItemMenuPlay"/>
                                        <MenuItem Header="{loc:Loc ContextMenu_AddToQueue}" Click="OnNavItemMenuQueue"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:Loc ContextMenu_Unpin}" Click="OnNavItemMenuUnpin"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="active-bar" Width="3" Margin="0,6" CornerRadius="0,2,2,0"
                                            Background="{DynamicResource BrushAccent}" IsVisible="{Binding IsActive}"/>

                                    <!-- FIX: ToolTip.ShowDelay expects an int (milliseconds), not a TimeSpan string -->
                                    <Button Grid.Column="1" Classes="nav sidebar-nav" Classes.active="{Binding IsActive}" Command="{Binding Command}"
                                            HorizontalAlignment="Stretch">
                                        <ToolTip.Tip>
                                            <Border Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" 
                                                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12,10" MinWidth="180">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" 
                                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}"
                                                               Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip.Tip>
                                        <Button.Styles>
                                            <Style Selector="Button /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </Button.Styles>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Classes="art-tile"
                                                    Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}"
                                                    Margin="0,0,10,0" CornerRadius="{StaticResource RadiusSm}"
                                                    Background="{StaticResource BrushAccentDim}" ClipToBounds="True">
                                                <Panel>
                                                    <Border CornerRadius="{StaticResource RadiusSm}"
                                                            IsVisible="{Binding ArtPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <Border.Background>
                                                            <ImageBrush Source="{Binding ArtPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <material:MaterialIcon Kind="{Binding IconKind}" Width="20" Height="20"
                                                            Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsVisible="{Binding ArtPath, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                                                        IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsSidebarExpanded}">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                           FontWeight="{Binding IsActive, Converter={x:Static converters:BoolToFontWeightConverter.Instance}}"/>
                                                <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}"
                                                           Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                                IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsSidebarExpanded}">

                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsCustomizingSidebar}">
                                            <Button Classes="sidebar-action" ToolTip.Tip="Move Up" Opacity="1"
                                                    Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.MoveUpCommand}"
                                                    CommandParameter="{Binding}">
                                                <material:MaterialIcon Kind="ArrowUp" Width="16" Height="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>
                                            <Button Classes="sidebar-action" ToolTip.Tip="Move Down" Opacity="1"
                                                    Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.MoveDownCommand}"
                                                    CommandParameter="{Binding}">
                                                <material:MaterialIcon Kind="ArrowDown" Width="16" Height="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsCustomizingSidebar, Converter={StaticResource BoolNegation}}">
                                            <Button Classes="sidebar-action" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_PlayAll}"
                                                    Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).PlayPlaylistCommand}"
                                                    CommandParameter="{Binding Playlist}"
                                                    IsVisible="{Binding Type, Converter={x:Static converters:NavItemTypeToVisibilityConverter.Instance}, ConverterParameter=PinnedPlaylist}">
                                                <material:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="{StaticResource BrushAccent}"/>
                                            </Button>
                                            <Button Classes="sidebar-action" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_Unpin}"
                                                    Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.UnpinCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding Type, Converter={x:Static converters:NavItemTypeToVisibilityConverter.Instance}, ConverterParameter=PinnedPlaylist}">
                                                <material:MaterialIcon Kind="PinOffOutline" Width="16" Height="16" Foreground="{StaticResource BrushTextMuted}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Nav.FolderNodes}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SidebarFolderNode">
                            <StackPanel Spacing="0">
                                <Border Classes="playlist-row" Tag="{Binding}"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragEnter="OnFolderDragEnter" DragDrop.DragLeave="OnFolderDragLeave"
                                        DragDrop.Drop="OnFolderDrop">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc ContextMenu_RenameFolder}" Click="OnFolderMenuRename"/>
                                            <MenuItem Header="{loc:Loc ContextMenu_DeleteFolder}" Click="OnFolderMenuDelete"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    
                                    <Grid>
                                        <!-- FIX: ToolTip.ShowDelay expects an int (milliseconds), not a TimeSpan string -->
                                        <Button Classes="nav sidebar-nav"
                                                Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.ToggleFolderCommand}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                                            <ToolTip.Tip>
                                                <Border Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" 
                                                        BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12,10" MinWidth="180">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Folder.Name}" FontWeight="SemiBold" FontSize="13" 
                                                                   Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Playlists.Count}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                            <TextBlock Text="Playlists" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip.Tip>
                                            <Button.Styles>
                                                <Style Selector="Button /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </Button.Styles>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Grid.Column="0" Classes="art-tile"
                                                        Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}"
                                                        Margin="0,0,10,0" CornerRadius="{StaticResource RadiusSm}"
                                                        Background="{StaticResource BrushSurface2}" ClipToBounds="True">
                                                    <material:MaterialIcon Kind="Folder" Width="20" Height="20"
                                                            Foreground="{StaticResource BrushAmber}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Folder.Name}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" Background="{StaticResource BrushSurface2}"
                                                        CornerRadius="{StaticResource RadiusFull}"
                                                        Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Playlists.Count}"
                                                               Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <material:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="16" Height="16"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        RenderTransform="{Binding IsExpanded, Converter={StaticResource BoolToRotate}}"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsSidebarExpanded}"/>
                                            </Grid>
                                        </Button>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                    IsVisible="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).IsSidebarExpanded}">
                                            <Button Classes="sidebar-action" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_RenameFolder}"
                                                    Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.RenameFolderCommand}"
                                                    CommandParameter="{Binding}">
                                                <material:MaterialIcon Kind="Pencil" Width="16" Height="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>
                                            <Button Classes="sidebar-action" ToolTip.Tip="{loc:Loc Sidebar_Tooltip_DeleteFolder}"
                                                    Command="{Binding $parent[controls:SidebarView].DataContext(vm:MainViewModel).Nav.DeleteFolderCommand}"
                                                    CommandParameter="{Binding}">
                                                <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0"
                                        Margin="18,0,0,4" Padding="0" IsVisible="{Binding IsExpanded}">
                                    <ItemsControl ItemsSource="{Binding Playlists}"
                                                  ItemTemplate="{StaticResource FolderChildRowTemplate}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnTopLevelDragEnter"
                        DragDrop.DragLeave="OnTopLevelDragLeave"
                        DragDrop.Drop="OnTopLevelDrop">
                    <Panel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Nav.UnpinnedPlaylists}"
                                      ItemTemplate="{StaticResource PlaylistRowTemplate}"/>
                        
                        <Border MinHeight="56"
                                IsVisible="{Binding Nav.IsReorderDragging}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Background="{StaticResource BrushAccentDim}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="PinOffOutline" Width="14" Height="14"
                                                       Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{loc:Loc Sidebar_DropToUnpin}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:Loc Sidebar_DropToUnpin}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeXs}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,16,0,0"
                                   IsVisible="{Binding !Nav.UnpinnedPlaylists.Count}"/>
                    </Panel>
                </Border>

                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="4,12,4,8"/>
                <TextBlock Classes="section-label" Text="{loc:Loc Sidebar_Section_Filters}" Margin="4,0,0,8" IsVisible="{Binding IsSidebarExpanded}"/>
                <Button Classes="nav sidebar-nav" Classes.active="{Binding Library.IsFavoritesView}" Command="{Binding Library.ShowFavoritesCommand}" ToolTip.Tip="{loc:Loc Sidebar_Filter_Favorites}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0" Classes="art-tile" Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}" Margin="0,0,10,0"
                                CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BrushSurface2}">
                            <material:MaterialIcon Kind="Star" Width="20" Height="20" Foreground="{StaticResource BrushAmber}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Sidebar_Filter_Favorites}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Button>
                <Button Classes="nav sidebar-nav" Classes.active="{Binding Library.IsRecentView}" Command="{Binding Library.ShowRecentCommand}" ToolTip.Tip="{loc:Loc Sidebar_Filter_Recent}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0" Classes="art-tile" Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}" Margin="0,0,10,0"
                                CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BrushSurface2}">
                            <material:MaterialIcon Kind="History" Width="20" Height="20" Foreground="{StaticResource BrushBlue}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Sidebar_Filter_Recent}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Button>

                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="4,12,4,8"/>
                <TextBlock Classes="section-label" Text="{loc:Loc Sidebar_Section_Sources}" Margin="4,0,0,8" IsVisible="{Binding IsSidebarExpanded}"/>
                <Button Classes="nav sidebar-nav" Classes.active="{Binding Library.IsYouTubeFilter}" Command="{Binding Library.FilterYouTubeCommand}" ToolTip.Tip="{loc:Loc Sidebar_Source_YouTube}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0" Classes="art-tile" Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}" Margin="0,0,10,0"
                                CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BrushSurface2}">
                            <material:MaterialIcon Kind="Youtube" Width="20" Height="20" Foreground="#FF0000"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Sidebar_Source_YouTube}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Button>
                <Button Classes="nav sidebar-nav" Classes.active="{Binding Library.IsSoundCloudFilter}" Command="{Binding Library.FilterSoundCloudCommand}" ToolTip.Tip="{loc:Loc Sidebar_Source_SoundCloud}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0" Classes="art-tile" Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}" Margin="0,0,10,0"
                                CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BrushSurface2}">
                            <material:MaterialIcon Kind="Soundcloud" Width="20" Height="20" Foreground="#FF5500"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Sidebar_Source_SoundCloud}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Button>
                <Button Classes="nav sidebar-nav" Classes.active="{Binding Library.IsLocalFilter}" Command="{Binding Library.FilterLocalCommand}" ToolTip.Tip="{loc:Loc Sidebar_Source_LocalFiles}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0" Classes="art-tile" Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}" Margin="0,0,10,0"
                                CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BrushSurface2}">
                            <material:MaterialIcon Kind="Folder" Width="20" Height="20" Foreground="{StaticResource BrushGreen}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Sidebar_Source_LocalFiles}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Border>