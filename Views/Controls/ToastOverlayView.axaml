<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:NullWave.Services"
             xmlns:models="using:NullWave.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Controls.ToastOverlayView"
             x:DataType="services:ToastService">
    
    <StackPanel DataContext="{x:Static services:ToastService.Instance}"
                IsVisible="{Binding HasActiveNotifications}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center">
        
        <!-- Dismiss All Button -->
        <Button Content="{loc:Loc Toast_DismissAll}" Classes="ghost" Padding="8,4"
                HorizontalAlignment="Center" Margin="0,0,0,6"
                IsVisible="{Binding ShowDismissAll}"
                Command="{Binding DismissAllCommand}"/>
                
        <!-- Notifications List -->
        <ItemsControl ItemsSource="{Binding ActiveToasts}" IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:LiveNotification">
                    <Border Classes="toast-card" Classes.dismissing="{Binding IsDismissing}" Width="380" Margin="0,2"
                            Background="{StaticResource BrushElevated}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}" BoxShadow="0 6 24 0 #40000000" ClipToBounds="True"
                            PointerEntered="OnToastPointerEntered"
                            PointerExited="OnToastPointerExited">
                        <Border.Styles>
                            <Style Selector="Border.toast-card">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="RenderTransform" Value="scale(1,1) translate(0,0)"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseIn"/>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseIn"/>
                                    </Transitions>
                                </Setter>
                                <Style.Animations>
                                    <Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
                                        <KeyFrame KeyTime="0:0:0">
                                            <Setter Property="Opacity" Value="0"/>
                                        </KeyFrame>
                                        <KeyFrame KeyTime="0:0:0.3">
                                            <Setter Property="Opacity" Value="1"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                            <Style Selector="Border.toast-card.dismissing">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="RenderTransform" Value="scale(0.97,0.97) translate(0px,8px)"/>
                            </Style>
                        </Border.Styles>
                        <Panel>
                            <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Background="{Binding NotificationBrush}"/>
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="12,10">
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="{StaticResource RadiusFull}"
                                        Background="{Binding NotificationTint}"
                                        VerticalAlignment="Top">
                                    <material:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                           Foreground="{Binding NotificationBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="4">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeSm}"
                                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <TextBlock Text="{Binding Message}"
                                           FontSize="{DynamicResource FontSizeXs}"
                                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"
                                           />
                                <ProgressBar IsVisible="{Binding ShowProgressBar}" Value="{Binding ProgressValue}"
                                             IsIndeterminate="{Binding IsIndeterminate}" Height="4" Margin="0,2,0,0"
                                             CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource BrushBorder}"
                                             Foreground="{Binding NotificationBrush}"/>
                                <Button IsVisible="{Binding ShowActionButton}" Command="{Binding ActionCommand}"
                                        Content="{Binding ActionButtonText}" Classes="ghost" Padding="8,3"
                                        HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeXs}"/>
                                <StackPanel IsVisible="{Binding HasDetailedMessage}" Margin="0,2,0,0">
                                    <Button Command="{Binding ToggleExpandCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Left" Cursor="Hand">
                                        <Panel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsExpanded}">
                                                <material:MaterialIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc Toast_ShowDetails}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsExpanded}">
                                                <material:MaterialIcon Kind="ChevronUp" Width="14" Height="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc Toast_HideDetails}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Panel>
                                    </Button>
                                    <Border IsVisible="{Binding IsExpanded}" Margin="0,6,0,0" Padding="8"
                                            Background="{StaticResource BrushBase}" CornerRadius="6"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding DetailedMessage}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="icon-btn sm"
                                        Command="{Binding CloseCommand}"
                                        VerticalAlignment="Top"
                                        ToolTip.Tip="{loc:Loc Toast_DismissAll}">
                                    <material:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>