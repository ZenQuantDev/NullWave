<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:models="using:NullWave.Models"
             xmlns:converters="using:NullWave.Helpers.Converters"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Controls.QueueView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource BrushSurface}"
             BorderBrush="{StaticResource BrushBorder}"
             BorderThickness="1,0,0,0">

    <UserControl.Resources>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Classes="panel-header">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="panel-title" Text="{loc:Loc Queue_Title}" Margin="0"/>
                    <TextBlock Classes="panel-title" Text="{Binding Queue.Tracks.Count, StringFormat='({0})'}" Foreground="{StaticResource BrushTextMuted}" FontWeight="Normal" Margin="0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Content="{loc:Loc Queue_Button_Clear}"
                        Command="{Binding Queue.ClearQueueCommand}"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        IsVisible="{Binding Queue.HasTracks}"/>
                <Button Grid.Column="2"
                        Classes="icon-btn"
                        Command="{Binding Queue.CloseCommand}">
                    <material:MaterialIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
            <Separator Classes="panel-header-sep"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Empty State -->
            <TextBlock Text="{loc:Loc Queue_Empty}"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="{DynamicResource FontSizeBody}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !Queue.HasTracks}"/>

            <!-- Track List -->
            <ListBox ItemsSource="{Binding Queue.Tracks}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     IsVisible="{Binding Queue.HasTracks}"
                     Margin="8,8,8,16">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueEntry">
                            <Grid Classes="draggable-row" ColumnDefinitions="24,8,40,8,*,Auto" Margin="4,4" MinHeight="{DynamicResource QueueRowHeight}"
                                  Tag="{Binding}"
                                  DoubleTapped="OnTrackDoubleTapped"
                                  DragDrop.AllowDrop="True"
                                  DragDrop.DragEnter="OnQueueItemDragEnter"
                                  DragDrop.DragLeave="OnQueueItemDragLeave"
                                  DragDrop.Drop="OnQueueItemDrop">

                                <!-- Drag Handle -->
                                <Border Grid.Column="0"
                                        Background="Transparent"
                                        Cursor="SizeAll"
                                        Tag="{Binding}"
                                        PointerPressed="OnQueueItemPointerPressed"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <material:MaterialIcon Kind="DragVertical" Width="18" Height="18"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>

                                <!-- Album Art -->
                                <Border Grid.Column="2"
                                        Width="{DynamicResource QueueArtSize}" Height="{DynamicResource QueueArtSize}"
                                        CornerRadius="{StaticResource RadiusArt}"
                                        Background="{StaticResource BrushSurface2}"
                                        ClipToBounds="True">
                                    <Panel>
                                        <Image Source="{Binding Track.AlbumArtPath, Converter={StaticResource PathToBitmap}}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding Track.AlbumArtPath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <material:MaterialIcon Kind="MusicNote"
                                                   IsVisible="{Binding Track.AlbumArtPath, Converter={x:Static ObjectConverters.IsNull}}"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Width="16" Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Panel>
                                </Border>

                                <!-- Track Info -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Track.Title}"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="{DynamicResource FontSizeSm}"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Track.Artist}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="{DynamicResource FontSizeXs}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Remove Button -->
                                <Button Grid.Column="5" Classes="icon-btn sm"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Queue.RemoveFromQueueCommand}"
                                        CommandParameter="{Binding Track}"
                                        ToolTip.Tip="{loc:Loc Queue_Tooltip_Remove}">
                                    <material:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>