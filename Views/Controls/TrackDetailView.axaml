<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:helpers="using:NullWave.Helpers"
        xmlns:converters="using:NullWave.Helpers.Converters"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="NullWave.Views.Controls.TrackDetailView"
        x:DataType="vm:MainViewModel"
        Background="{StaticResource BrushSurface}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1,0,0,0"
        Width="{Binding Detail.PanelWidth}"
        Opacity="{Binding Detail.PanelOpacity}"
        ClipToBounds="True">
    <Border.Resources>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:SourceToBackgroundConverter x:Key="SourceToBg"/>
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
    </Border.Resources>
    <Border.Transitions>
        <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="ExponentialEaseOut"/>
            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
    </Border.Transitions>
    
    <!-- Switched to a Grid layout to pin the top sections fixed in place -->
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ROW 0: Fixed Album Art -->
        <Border Grid.Row="0" Height="220"
                Background="{StaticResource BrushSurface2}"
                ClipToBounds="True">
            <Panel>
                <Image Source="{Binding Detail.CurrentTrackArtPath,
                           Converter={StaticResource PathToBitmap}}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding Detail.CurrentTrackArtPath,
                           Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding Detail.CurrentTrackArtPath,
                           Converter={x:Static ObjectConverters.IsNull}}">
                    <material:MaterialIcon Kind="MusicNote"
                                           Width="52" Height="52"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                    <TextBlock Text="No artwork"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Panel>
        </Border>
        
        <!-- ROW 1: Fixed Header -->
        <StackPanel Grid.Row="1" Spacing="0" Margin="16,16,16,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Detail.EditTitle}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        Command="{Binding Detail.CloseCommand}">
                    <material:MaterialIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
            <Separator Background="{StaticResource BrushBorder}" Margin="0,12,0,0"/>
        </StackPanel>
        
        <!-- ROW 2: Scrollable Content Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="16,12,16,20">
                <!-- Title -->
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-label" Text="TITLE" Margin="0"/>
                    <TextBox Text="{Binding Detail.EditTitle, Mode=TwoWay}"/>
                </StackPanel>
                
                <!-- Artist -->
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-label" Text="ARTIST" Margin="0"/>
                    <TextBox Text="{Binding Detail.EditArtist, Mode=TwoWay}"/>
                </StackPanel>
                
                <!-- Source + Favorite -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Classes="section-label" Text="SOURCE" Margin="0"/>
                        <Border CornerRadius="{StaticResource RadiusFull}"
                                Padding="10,4"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Detail.DisplaySource,
                                    Converter={StaticResource SourceToBg}}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding Detail.DisplaySource}"
                                       Foreground="White"
                                       FontSize="{StaticResource FontSizeXs}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn"
                            Command="{Binding Detail.ToggleFavoriteCommand}"
                            ToolTip.Tip="Toggle Favorite"
                            VerticalAlignment="Bottom">
                        <material:MaterialIcon Kind="{Binding Detail.IsFavorite, Converter={StaticResource BoolToIconKind}, ConverterParameter='Star, StarOutline'}"
                                               Width="22" Height="22"
                                               Foreground="{StaticResource BrushAmber}"
                                               Opacity="{Binding Detail.IsFavorite, Converter={StaticResource BoolToOpacity}}"/>
                    </Button>
                </Grid>
                
                <!-- Stats -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="section-label" Text="PLAYS" Margin="0"/>
                        <TextBlock Text="{Binding Detail.DisplayPlayCount}"
                                   Foreground="{StaticResource BrushBlue}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="section-label" Text="LAST PLAYED" Margin="0"/>
                        <TextBlock Text="{Binding Detail.DisplayLastPlayed}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                
                <!-- Date added -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="section-label" Text="DATE ADDED" Margin="0"/>
                    <TextBlock Text="{Binding Detail.DisplayDateAdded}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="{StaticResource FontSizeBody}"/>
                </StackPanel>
                
                <!-- URL / Path -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="URL / PATH" Margin="0"/>
                    <TextBlock Text="{Binding Detail.DisplayUrl}"
                               Foreground="{StaticResource BrushBlue}"
                               FontSize="{StaticResource FontSizeXs}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost"
                                Content="{Binding Detail.CopyStatus}"
                                Command="{Binding Detail.CopyUrlCommand}"
                                Padding="12,5"/>
                        <Button Classes="ghost"
                                Content="Relink File..."
                                Command="{Binding Detail.RelinkFileCommand}"
                                ToolTip.Tip="Point this track at a different audio file on disk — use when Verify Links flags a mis-linked file."
                                Padding="12,5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="section-label" Text="ARTIST INFO" Margin="0"/>
                    <Border Background="{StaticResource BrushSurface2}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Detail.ArtistBio}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.HasArtistBio}"/>
                            <TextBlock Text="No artist biography available yet."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.ShowLibraryFallback}"/>
                            <TextBlock Text="Loading artist info..."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       IsVisible="{Binding Detail.IsLoadingArtistInfo}"/>
                            <TextBlock Text="{Binding Detail.ArtistListeners, StringFormat='Listeners: {0}'}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       IsVisible="{Binding Detail.HasArtistBio}"/>
                            <TextBlock Text="{Binding Detail.LibraryArtistTrackCount, StringFormat='Library matches: {0}'}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       IsVisible="{Binding Detail.ShowLibraryFallback}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Separator Background="{StaticResource BrushBorder}"/>
                
                <!-- Redesigned High-Density Tag Cloud -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-label" Text="TAGS" Margin="0"/>
                    <ItemsControl ItemsSource="{Binding Detail.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{StaticResource BrushSurface2}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3,4,3"
                                        Margin="0,0,4,4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource BrushAccentHover}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                        <Button Width="14" Height="14"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Detail.RemoveTagCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushRed}"/>
                                                </Style>
                                            </Button.Styles>
                                            <material:MaterialIcon Kind="Close"
                                                                   Width="8"
                                                                   Height="8"
                                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Detail.NewTag, Mode=TwoWay}"
                                 PlaceholderText="Add tag..."
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Classes="primary"
                                Command="{Binding Detail.AddTagCommand}"
                                Padding="14,8">
                            <material:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </StackPanel>
                
                <Separator Background="{StaticResource BrushBorder}"/>
                
                <!-- Notes -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="NOTES" Margin="0"/>
                    <TextBox Text="{Binding Detail.EditNotes, Mode=TwoWay}"
                             PlaceholderText="Add notes..."
                             AcceptsReturn="True"
                             Height="80"/>
                </StackPanel>
                
                <!-- Save -->
                <Button Classes="primary"
                        Content="Save Changes"
                        Command="{Binding Detail.SaveCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Border>