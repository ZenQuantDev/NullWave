<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:converters="using:NullWave.Helpers.Converters"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:loc="using:NullWave.Helpers.Localization"
        x:Class="NullWave.Views.Controls.TrackDetailView"
        x:DataType="vm:MainViewModel"
        Background="{StaticResource BrushSurface}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1,0,0,0"
        ClipToBounds="True">
    <Border.Resources>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <converters:SourceToBackgroundConverter x:Key="SourceToBg"/>
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
    </Border.Resources>
    <!-- LOCAL STYLE OVERRIDES: Boost section-label contrast within this inspector.
         The global section-label uses BrushTextMuted (faint gray) which fails
         WCAG AA contrast on BrushSurface. Override to BrushTextSecondary + SemiBold
         for better readability without affecting the rest of the app. -->
    <Border.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Border.Styles>
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ROW 0: Fixed Album Art — FIT-TO-MAT (Uniform), not crop-to-fill.
             The card background acts as a neutral mat. Square art renders 220x220 centered;
             16:9 art renders full-width; no more baked-in black/maroon pillars. -->
        <Border Grid.Row="0" Height="{DynamicResource DetailArtHeight}"
                Background="{StaticResource BrushSurface2}"
                ClipToBounds="True">
            <Panel>
                <Image Source="{Binding Detail.CurrentTrackArtPath,
                                        Converter={StaticResource PathToBitmap}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding Detail.CurrentTrackArtPath,
                                           Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding Detail.CurrentTrackArtPath,
                                                Converter={x:Static ObjectConverters.IsNull}}">
                    <material:MaterialIcon Kind="MusicNote"
                                           Width="52" Height="52"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Detail_NoArtwork}"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Panel>
        </Border>
        <!-- ROW 1: Fixed Header -->
        <StackPanel Grid.Row="1" Spacing="0" Margin="16,16,16,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Detail.EditTitle}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{DynamicResource FontSizeLg}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Classes="icon-btn"
                        Command="{Binding Detail.CloseCommand}">
                    <material:MaterialIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
            <Separator Background="{StaticResource BrushBorder}" Margin="0,12,0,0"/>
        </StackPanel>
        <!-- ROW 2: Scrollable Content Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="16,12,16,20">
                <!-- Title -->
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Title}" Margin="0"/>
                    <TextBox Text="{Binding Detail.EditTitle, Mode=TwoWay}"/>
                </StackPanel>
                <!-- Artist -->
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Artist}" Margin="0"/>
                    <TextBox Text="{Binding Detail.EditArtist, Mode=TwoWay}"/>
                </StackPanel>
                <!-- Source + Favorite -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Source}" Margin="0"/>
                        <Border CornerRadius="{StaticResource RadiusFull}"
                                Padding="10,4"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Detail.DisplaySource,
                                                Converter={StaticResource SourceToBg}}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding Detail.DisplaySource}"
                                       Foreground="White"
                                       FontSize="{DynamicResource FontSizeXs}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon-btn"
                            Command="{Binding Detail.ToggleFavoriteCommand}"
                            ToolTip.Tip="{loc:Loc Detail_Tooltip_Favorite}"
                            VerticalAlignment="Bottom">
                        <material:MaterialIcon Kind="{Binding Detail.IsFavorite, Converter={StaticResource BoolToIconKind}, ConverterParameter='Star, StarOutline'}"
                                               Width="22" Height="22"
                                               Foreground="{StaticResource BrushAmber}"
                                               Opacity="{Binding Detail.IsFavorite, Converter={StaticResource BoolToOpacity}}"/>
                    </Button>
                </Grid>
                <!-- Stats -->
                <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Plays}" Margin="0"/>
                        <TextBlock Text="{Binding Detail.DisplayPlayCount}"
                                   Foreground="{StaticResource BrushBlue}"
                                   FontSize="{DynamicResource FontSizeLg}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_LastPlayed}" Margin="0"/>
                        <TextBlock Text="{Binding Detail.DisplayLastPlayed}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeSm}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Length}" Margin="0"/>
                        <TextBlock Text="{Binding Detail.DisplayDuration}"
                                   Foreground="{StaticResource BrushBlue}"
                                   FontSize="{DynamicResource FontSizeLg}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <!-- Date added -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_DateAdded}" Margin="0"/>
                    <TextBlock Text="{Binding Detail.DisplayDateAdded}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="{DynamicResource FontSizeBody}"/>
                </StackPanel>
                <!-- URL / Path: monospace code-chip with inline copy button -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_UrlPath}" Margin="0"/>
                    <Border Background="{StaticResource BrushSurface2}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Detail.DisplayUrl}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="icon-btn sm"
                                    Command="{Binding Detail.CopyUrlCommand}"
                                    ToolTip.Tip="{Binding Detail.CopyStatus}"
                                    VerticalAlignment="Top">
                                <material:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Button Classes="ghost"
                            Content="{loc:Loc Detail_Button_Relink}"
                            Command="{Binding Detail.RelinkFileCommand}"
                            ToolTip.Tip="{loc:Loc Detail_Tooltip_Relink}"
                            Padding="12,5"
                            HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_ArtistInfo}" Margin="0"/>
                    <!-- Spotify-style Artist Hero -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Border Width="100" Height="100" CornerRadius="50" ClipToBounds="True" Background="{StaticResource BrushSurface2}">
                            <Panel>
                                <Image Source="{Binding Detail.ArtistImagePath, Converter={StaticResource PathToBitmap}}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding Detail.ArtistImagePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <material:MaterialIcon Kind="AccountMusic"
                                                       IsVisible="{Binding Detail.ArtistImagePath, Converter={x:Static ObjectConverters.IsNull}}"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Width="40" Height="40"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Border>
                        <TextBlock Text="{Binding Detail.EditArtist}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{DynamicResource FontSizeMd}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"/>
                    </StackPanel>
                    <!-- Bio Card -->
                    <Border Background="{StaticResource BrushSurface2}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Detail.ArtistBio}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.HasArtistBio}"/>
                            <TextBlock Text="{loc:Loc Detail_ArtistBio_Empty}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.ShowLibraryFallback}"/>
                            <TextBlock Text="{loc:Loc Detail_ArtistBio_Loading}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       IsVisible="{Binding Detail.IsLoadingArtistInfo}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Detail.HasArtistBio}">
                                <TextBlock Text="{loc:Loc Detail_Artist_MonthlyListeners}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                <TextBlock Text="{Binding Detail.ArtistListeners}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Detail.ShowLibraryFallback}">
                                <TextBlock Text="{loc:Loc Detail_Artist_LibraryMatches}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                <TextBlock Text="{Binding Detail.LibraryArtistTrackCount}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Similar Artists -->
                    <StackPanel Spacing="8" IsVisible="{Binding Detail.HasSimilarArtists}">
                        <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_FansAlsoLike}" Margin="0"/>
                        <ItemsControl ItemsSource="{Binding Detail.SimilarArtists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{StaticResource BrushSurface2}"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="12,6"
                                            Margin="0,0,6,6"
                                            Cursor="Hand">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontSize="{DynamicResource FontSizeSm}"
                                                   FontWeight="Medium"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <Separator Background="{StaticResource BrushBorder}"/>
                <!-- Tags -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Tags}" Margin="0"/>
                    <ItemsControl ItemsSource="{Binding Detail.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{StaticResource BrushSurface2}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3,4,3"
                                        Margin="0,0,4,4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource BrushAccentHover}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                        <Button Width="14" Height="14"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Detail.RemoveTagCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushRed}"/>
                                                </Style>
                                            </Button.Styles>
                                            <material:MaterialIcon Kind="Close"
                                                                   Width="8"
                                                                   Height="8"
                                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Detail.NewTag, Mode=TwoWay}"
                                 PlaceholderText="{loc:Loc Detail_Placeholder_AddTag}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Classes="primary"
                                Command="{Binding Detail.AddTagCommand}"
                                Padding="14,8">
                            <material:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </StackPanel>
                <Separator Background="{StaticResource BrushBorder}"/>
                <!-- Notes -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{loc:Loc Detail_Section_Notes}" Margin="0"/>
                    <TextBox Text="{Binding Detail.EditNotes, Mode=TwoWay}"
                             PlaceholderText="{loc:Loc Detail_Placeholder_AddNotes}"
                             AcceptsReturn="True"
                             Height="80"/>
                </StackPanel>
                <!-- Save -->
                <Button Classes="primary"
                        Content="{loc:Loc Detail_Button_Save}"
                        Command="{Binding Detail.SaveCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Border>