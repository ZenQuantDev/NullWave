<DockPanel xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:vm="using:NullWave.ViewModels"
           xmlns:models="using:NullWave.Models"
           xmlns:converters="using:NullWave.Helpers.Converters"
           xmlns:material="using:Material.Icons.Avalonia"
           xmlns:attached="using:NullWave.Helpers.Attached"
           xmlns:helpers="using:NullWave.Helpers"
           xmlns:loc="using:NullWave.Helpers.Localization"
           x:Class="NullWave.Views.Controls.TrackListView"
           x:DataType="vm:LibraryViewModel">
    <DockPanel.Resources>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <converters:SourceToBackgroundConverter x:Key="SourceToBg"/>
        <converters:TrackIdEqualsConverter x:Key="TrackIdEquals"/>
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
        <converters:BoolToBrushConverter x:Key="StarBrush" TrueBrush="{StaticResource BrushStarOn}" FalseBrush="{StaticResource BrushStarOff}"/>
        <converters:SortFieldDisplayConverter x:Key="SortFieldDisplay"/>
        <converters:BoolToSortIconConverter x:Key="BoolToSortIcon"/>
        <converters:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibility"/>
        <converters:MediaTypeToIconKindConverter x:Key="MediaTypeToIconKind"/>
        <converters:RadioNowPlayingConverter x:Key="RadioNowPlaying"/>
        
        <!-- Lightweight Path-based icon converters -->
        <helpers:MediaTypeToGeometryConverter x:Key="MediaTypeToGeom"/>
        <helpers:BoolToStarGeometryConverter x:Key="BoolToStarGeom"/>
    </DockPanel.Resources>

    <!-- COLUMN HEADERS -->
        <Border DockPanel.Dock="Top" Classes="wallpaper-row-header">
            <Grid Margin="16,8,16,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2.6*"  MinWidth="260"/>
            <ColumnDefinition Width="0.9*"  MinWidth="120"/>
            <ColumnDefinition Width="0.5*"  MinWidth="64"/>
            <ColumnDefinition Width="0.5*"  MinWidth="70"/>
            <ColumnDefinition Width="0.5*"  MinWidth="80"/>
            <ColumnDefinition Width="0.8*"  MinWidth="110"/>
            <ColumnDefinition Width="0.35*" MinWidth="36"/>
            <ColumnDefinition Width="0.35*" MinWidth="36"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" Classes="section-label"
                   Text="{Binding ResultCountLabel}"
                   FontSize="{DynamicResource FontSizeXs}"
                   Margin="4,0,0,0"/>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding SortByTitleCommand}"
                HorizontalContentAlignment="Left" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="{loc:Loc Library_Header_TitleArtist}" Margin="0"/>
                <material:MaterialIcon Kind="{Binding SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding IsSortedByTitle}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding SortBySourceCommand}"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="{loc:Loc Library_Header_Source}" Margin="0"/>
                <material:MaterialIcon Kind="{Binding SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding IsSortedBySource}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding SortByPlayCountCommand}"
                HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="{loc:Loc Library_Header_Plays}" Margin="0"/>
                <material:MaterialIcon Kind="{Binding SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding IsSortedByPlayCount}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" HorizontalContentAlignment="Center">
            <TextBlock Classes="section-label" Text="{loc:Loc Library_Header_Length}" Margin="0"/>
        </Button>
        <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" HorizontalContentAlignment="Center">
            <TextBlock Classes="section-label" Text="{loc:Loc Library_Header_Status}" Margin="0"/>
        </Button>
        <Button Grid.Column="6" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding SortByDateCommand}"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="{loc:Loc Library_Header_Added}" Margin="0"/>
                <material:MaterialIcon Kind="{Binding SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding IsSortedByDate}"/>
            </StackPanel>
        </Button>
            </Grid>
        </Border>

    <!-- List + floating bulk bar -->
    <Panel>
        <ListBox x:Name="TrackList"
                 ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding SelectedTrack}"
                 SelectionMode="Multiple"
                 Background="Transparent"
                 Margin="8,0,8,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnTrackSelected"
                 DoubleTapped="OnTrackDoubleTapped"
                 ContextRequested="OnListContextRequested">
            
            <!-- Hoisted to ListBox.Styles to prevent per-container style instantiation overhead -->
            <ListBox.Styles>
                <Style Selector="Grid.track-row:pointerover">
                    <Setter Property="Background" Value="{StaticResource BrushElevated}"/>
                </Style>
                <Style Selector="ListBoxItem:selected Grid.track-row">
                    <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
                </Style>
            </ListBox.Styles>

            <!-- Default VirtualizingStackPanel (CacheLength=0) prevents massive rebind storms on thumb drag -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <!-- LOCALIZED HOVER: Background and transitions applied directly to the row Grid 
                         to prevent full-viewport invalidation caused by ListBoxItem:pointerover -->
                      <Grid Margin="{DynamicResource RowMargin}" MinHeight="{DynamicResource TrackRowHeight}"
                          Classes="track-row">
                        <Grid.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Grid.Transitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2.6*"  MinWidth="260"/>
                            <ColumnDefinition Width="0.9*"  MinWidth="120"/>
                            <ColumnDefinition Width="0.5*"  MinWidth="64"/>
                            <ColumnDefinition Width="0.5*"  MinWidth="70"/>
                            <ColumnDefinition Width="0.5*"  MinWidth="80"/>
                            <ColumnDefinition Width="0.8*"  MinWidth="110"/>
                            <ColumnDefinition Width="0.35*" MinWidth="36"/>
                            <ColumnDefinition Width="0.35*" MinWidth="36"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- ACCENT BAR -->
                        <Border Grid.Column="0"
                                Width="3"
                                HorizontalAlignment="Left"
                                Margin="-8,0,0,0"
                                Background="{DynamicResource BrushAccent}"
                                CornerRadius="0,2,2,0">
                            <Border.IsVisible>
                                <MultiBinding Converter="{StaticResource TrackIdEquals}">
                                    <Binding Path="Id"/>
                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Player.CurrentTrack.Id" />
                                </MultiBinding>
                            </Border.IsVisible>
                        </Border>

                        <Border Grid.Column="0"
                                Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}"
                                CornerRadius="{StaticResource RadiusArt}"
                                Background="{StaticResource BrushSurface2}"
                                ClipToBounds="True"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <Panel>
                                <Image attached:AsyncImage.SourcePath="{Binding AlbumArtPath}"
                                       attached:AsyncImage.DecodeWidth="96"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding AlbumArtPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                                
                                <!-- Lightweight Path icon (size-baked, Stretch="None") -->
                                <Path Data="{Binding MediaType, Converter={StaticResource MediaTypeToGeom}}"
                                      Stretch="None" Width="18" Height="18"
                                      Fill="{StaticResource BrushTextMuted}"
                                      IsVisible="{Binding AlbumArtPath, Converter={x:Static ObjectConverters.IsNull}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2"
                                    Margin="10,0,8,0">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{DynamicResource RowTitleSize}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{DynamicResource RowSubSize}"
                                       TextTrimming="CharacterEllipsis"/>
                               
                            <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Player.NowPlayingDisplay}"
                                       Foreground="{StaticResource BrushAccent}"
                                       FontSize="{DynamicResource RowSubSize}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource RadioNowPlaying}">
                                        <Binding Path="Id"/>
                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Player.CurrentTrack.Id" />
                                        <Binding Path="IsRadio"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border CornerRadius="{StaticResource RadiusFull}" Padding="10,4"
                                    IsVisible="{Binding !IsRadio}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Source, Converter={StaticResource SourceToBg}}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding Source}"
                                           Foreground="White"
                                           FontSize="{DynamicResource FontSizeXs}"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Border CornerRadius="{StaticResource RadiusFull}" Padding="10,4" Background="{StaticResource BrushRedDim}"
                                    IsVisible="{Binding IsRadio}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushRed}" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE" Foreground="{StaticResource BrushRed}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding PlayCount}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeSm}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DisplayDuration}" Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSm}" HorizontalAlignment="Center"
                                       IsVisible="{Binding !IsRadio}"/>
                            <TextBlock Text="∞" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"
                                       HorizontalAlignment="Center" IsVisible="{Binding IsRadio}"
                                       ToolTip.Tip="{loc:Loc Radio_Live_Stream}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <!-- Size-baked: AccessPoint16, Stretch="None" -->
                            <Path Data="{x:Static helpers:RowIcons.AccessPoint16}" Stretch="None" Width="16" Height="16"
                                  Fill="{StaticResource BrushBlue}"
                                  IsVisible="{Binding IsRadio}" ToolTip.Tip="{loc:Loc Radio_Live_Stream}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsRadio}">
                                <!-- Size-baked: CheckCircle16, Stretch="None" -->
                                <Path Data="{x:Static helpers:RowIcons.CheckCircle16}" Stretch="None" Width="16" Height="16"
                                      Fill="{StaticResource BrushGreen}"
                                      IsVisible="{Binding FilePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <!-- Size-baked: CloudOff16, Stretch="None" -->
                                <Path Data="{x:Static helpers:RowIcons.CloudOff16}" Stretch="None" Width="16" Height="16"
                                      Fill="{StaticResource BrushTextMuted}"
                                      IsVisible="{Binding FilePath, Converter={x:Static ObjectConverters.IsNull}}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="6"
                                   Text="{Binding DateAdded, StringFormat='{}{0:MMM dd, yyyy}'}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeSm}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="7"
                                Classes="icon-btn"
                                CommandParameter="{Binding}"
                                Command="{Binding $parent[ListBox].DataContext.ToggleFavoriteCommand}"
                                ToolTip.Tip="{loc:Loc Library_Tooltip_Favorite}"
                                VerticalAlignment="Center">
                            <Path Data="{Binding IsFavorite, Converter={StaticResource BoolToStarGeom}}"
                                  Stretch="None" Width="18" Height="18"
                                  Fill="{Binding IsFavorite, Converter={StaticResource StarBrush}}"/>
                        </Button>

                        <Button Grid.Column="8"
                                Classes="icon-btn"
                                VerticalAlignment="Center"
                                Click="OnRowMenuClick"
                                ToolTip.Tip="{loc:Loc Library_Tooltip_MoreOptions}">
                            <!-- Size-baked: DotsVertical18, Stretch="None" -->
                            <Path Data="{x:Static helpers:RowIcons.DotsVertical18}" Stretch="None" Width="18" Height="18"
                                  Fill="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- FLOATING BULK ACTION BAR (multi-select) -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                Background="{StaticResource BrushElevated}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusFull}" Padding="10,6"
                IsVisible="{Binding HasMultiSelection}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding SelectionCountLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeXs}" Margin="4,0,6,0"/>
                <Button Classes="icon-btn" Command="{Binding BulkToggleFavoriteCommand}" ToolTip.Tip="Favorite selected">
                    <material:MaterialIcon Kind="Star" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon-btn" Command="{Binding BulkAddToQueueCommand}" ToolTip.Tip="Add to queue">
                    <material:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon-btn" Command="{Binding BulkAddToPlaylistCommand}" ToolTip.Tip="Add to playlist">
                    <material:MaterialIcon Kind="PlaylistMusic" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon-btn" Command="{Binding BulkRemoveCommand}" ToolTip.Tip="Remove selected">
                    <material:MaterialIcon Kind="TrashCan" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>

    </Panel>
</DockPanel>