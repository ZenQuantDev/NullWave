<DockPanel xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:vm="using:NullWave.ViewModels"
           xmlns:models="using:NullWave.Models"
           xmlns:helpers="using:NullWave.Helpers"
           xmlns:converters="using:NullWave.Helpers.Converters"
           xmlns:material="using:Material.Icons.Avalonia"
           xmlns:services="using:NullWave.Services"
           x:Class="NullWave.Views.Controls.TrackListView"
           x:DataType="vm:MainViewModel">
    <DockPanel.Resources>
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <converters:SourceToBackgroundConverter x:Key="SourceToBg"/>
        <converters:TrackIdEqualsConverter x:Key="TrackIdEquals"/>
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
        <converters:SortFieldDisplayConverter x:Key="SortFieldDisplay"/>
        <converters:BoolToSortIconConverter x:Key="BoolToSortIcon"/>
    </DockPanel.Resources>

    <!-- COLUMN HEADERS -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="48,*,150,80,80,110,36,36"
          Margin="16,8,16,2">
        <TextBlock Grid.Column="0" Classes="section-label"
                   Text="{Binding Library.ResultCountLabel}"
                   FontSize="{DynamicResource FontSizeXs}"
                   Margin="4,0,0,0"/>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortByTitleCommand}"
                HorizontalContentAlignment="Left" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="TITLE / ARTIST" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding Library.IsSortedByTitle}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortBySourceCommand}"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="SOURCE" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding Library.IsSortedBySource}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortByPlayCountCommand}"
                HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="PLAYS" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding Library.IsSortedByPlayCount}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" HorizontalContentAlignment="Center">
            <TextBlock Classes="section-label" Text="OFFLINE" Margin="0"/>
        </Button>
        <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortByDateCommand}"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="ADDED" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                       Width="12" Height="12"
                                       IsVisible="{Binding Library.IsSortedByDate}"/>
            </StackPanel>
        </Button>
    </Grid>

    <!-- TRACK LIST -->
    <ListBox ItemsSource="{Binding Library.Tracks}"
             SelectedItem="{Binding Library.SelectedTrack}"
             Background="Transparent"
             Margin="8,0,8,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="OnTrackSelected"
             DoubleTapped="OnTrackDoubleTapped">
        <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem"
                          BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <MenuItem Header="Play"
                                      Command="{Binding $parent[ListBox].DataContext.Library.PlayTrackCommand}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="View Details"
                                      Command="{Binding $parent[ListBox].DataContext.Library.OpenDetailCommand}"/>
                            <MenuItem Header="Toggle Favorite"
                                      Command="{Binding $parent[ListBox].DataContext.Library.ToggleFavoriteCommand}"/>
                            <MenuItem Header="Add to Queue"
                                      Command="{Binding $parent[ListBox].DataContext.Library.AddToQueueCommand}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Add to Playlist..."
                                      Command="{Binding $parent[ListBox].DataContext.AddTrackToPlaylistCommand}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Copy URL"
                                      Command="{Binding $parent[ListBox].DataContext.Library.CopyUrlCommand}"/>
                            <Separator/>
                            <MenuItem Header="Remove"
                                      Command="{Binding $parent[ListBox].DataContext.Library.RemoveTrackCommand}"
                                      CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:Track">
                <Grid ColumnDefinitions="48,*,150,80,80,110,36,36"
                      Margin="{DynamicResource RowMargin}" MinHeight="{DynamicResource TrackRowHeight}">
                    <!-- Now-playing accent bar (DynamicResource so it follows accent changes live) -->
                    <Border Grid.Column="0"
                            Width="3"
                            HorizontalAlignment="Left"
                            Margin="-8,-5,0,-5"
                            Background="{DynamicResource BrushAccent}"
                            CornerRadius="0,2,2,0">
                        <Border.IsVisible>
                            <MultiBinding Converter="{StaticResource TrackIdEquals}">
                                <Binding Path="Id"/>
                                <Binding Path="$parent[ListBox].DataContext.Player.CurrentTrack.Id"/>
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                    
                    <!-- Album art -->
                    <Border Grid.Column="0"
                            Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}"
                            CornerRadius="{StaticResource RadiusArt}"
                            Background="{StaticResource BrushSurface2}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Panel>
                            <Image Source="{Binding AlbumArtPath, Converter={StaticResource PathToBitmap}}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding AlbumArtPath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <material:MaterialIcon Kind="MusicNote"
                                                   IsVisible="{Binding AlbumArtPath, Converter={x:Static ObjectConverters.IsNull}}"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Width="18" Height="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                    
                    <!-- Title + artist -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2"
                                Margin="10,0,8,0">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{DynamicResource RowTitleSize}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="{DynamicResource RowSubSize}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    
                    <!-- Source badge -->
                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Source, Converter={StaticResource SourceToBg}}"/>
                        </Border.Background>
                        <TextBlock Text="{Binding Source}"
                                   Foreground="White"
                                   FontSize="{DynamicResource FontSizeXs}"
                                   FontWeight="SemiBold"/>
                    </Border>
                    
                    <!-- Play count -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding PlayCount}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSm}"
                               VerticalAlignment="Center"/>
                    
                    <!-- Offline indicator -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <material:MaterialIcon Kind="CheckCircle"
                                               Width="16" Height="16"
                                               Foreground="{StaticResource BrushGreen}"
                                               IsVisible="{Binding FilePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <material:MaterialIcon Kind="CloudOff"
                                               Width="16" Height="16"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               IsVisible="{Binding FilePath, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </StackPanel>
                    
                    <!-- Date added -->
                    <TextBlock Grid.Column="5"
                               Text="{Binding DateAdded, StringFormat='{}{0:MMM dd, yyyy}'}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSm}"
                               VerticalAlignment="Center"/>
                    
                    <!-- Favorite star -->
                    <Button Grid.Column="6"
                            Classes="icon-btn"
                            Command="{Binding $parent[ListBox].DataContext.Library.ToggleFavoriteCommand}"
                            ToolTip.Tip="Toggle Favorite"
                            VerticalAlignment="Center">
                        <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToIconKind}, ConverterParameter='Star, StarOutline'}"
                                               Width="18" Height="18"
                                               Foreground="{StaticResource BrushAmber}"
                                               Opacity="{Binding IsFavorite, Converter={StaticResource BoolToOpacity}}"/>
                    </Button>
                    
                    <!-- More options -->
                    <Button Grid.Column="7"
                            Classes="icon-btn"
                            VerticalAlignment="Center"
                            ToolTip.Tip="More options">
                        <material:MaterialIcon Kind="DotsVertical" Width="18" Height="18"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Play"
                                          Command="{Binding $parent[ListBox].DataContext.Library.PlayTrackCommand}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="View Details"
                                          Command="{Binding $parent[ListBox].DataContext.Library.OpenDetailCommand}"/>
                                <MenuItem Header="Toggle Favorite"
                                          Command="{Binding $parent[ListBox].DataContext.Library.ToggleFavoriteCommand}"/>
                                <MenuItem Header="Add to Queue"
                                          Command="{Binding $parent[ListBox].DataContext.Library.AddToQueueCommand}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Add to Playlist..."
                                          Command="{Binding $parent[ListBox].DataContext.AddTrackToPlaylistCommand}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Copy URL"
                                          Command="{Binding $parent[ListBox].DataContext.Library.CopyUrlCommand}"/>
                                <Separator/>
                                <MenuItem Header="Remove"
                                          Command="{Binding $parent[ListBox].DataContext.Library.RemoveTrackCommand}"
                                          CommandParameter="{Binding}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</DockPanel>