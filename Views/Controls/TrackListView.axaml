<DockPanel xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:vm="using:NullWave.ViewModels"
           xmlns:models="using:NullWave.Models"
           xmlns:helpers="using:NullWave.Helpers"
           xmlns:converters="using:NullWave.Helpers.Converters"
           xmlns:material="using:Material.Icons.Avalonia"
           x:Class="NullWave.Views.Controls.TrackListView"
           x:DataType="vm:MainViewModel">

    <DockPanel.Resources>
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
        <converters:SourceToBackgroundConverter x:Key="SourceToBg"/>
        <converters:TrackIdEqualsConverter x:Key="TrackIdEquals"/>
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
        <converters:SortFieldDisplayConverter x:Key="SortFieldDisplay"/>
        <converters:BoolToSortIconConverter x:Key="BoolToSortIcon"/>
    </DockPanel.Resources>

    <!--  TOOLBAR  -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto" VerticalAlignment="Center">
            <TextBox Grid.Column="0"
                     Text="{Binding Library.SearchQuery, Mode=TwoWay}"
                     PlaceholderText="Search (e.g., 'artist:tame impala' or 'is:favorite')..."
                     VerticalAlignment="Center">
                <TextBox.InnerLeftContent>
                    <material:MaterialIcon Kind="Magnify"
                                           Width="16" Height="16"
                                           Margin="8,0,0,0"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="help-btn" VerticalAlignment="Center" ToolTip.Tip="Search syntax">
                            <material:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="6" MaxWidth="260" Margin="4">
                                        <TextBlock FontWeight="SemiBold" Text="Search syntax"/>
                                        <TextBlock Text="artist:name or a:name — filter by artist" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                                        <TextBlock Text="title:name or t:name — filter by title" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                                        <TextBlock Text="source:youtube or s:youtube — filter by source" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                                        <TextBlock Text="tag:chill or genre:chill — filter by tag" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                                        <TextBlock Text="is:favorite — favorites only" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                                        <TextBlock Text="-word or -artist:name — exclude matches" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSm}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="icon-btn sm"
                                Command="{Binding Library.ClearSearchTextCommand}"
                                IsVisible="{Binding Library.HasSearchQuery}"
                                ToolTip.Tip="Clear search">
                            <material:MaterialIcon Kind="Close" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </TextBox.InnerRightContent>
            </TextBox>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Library.SortOptions}"
                      SelectedItem="{Binding Library.CurrentSort}"
                      MinWidth="130"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource SortFieldDisplay}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="4"
                    Classes="icon-btn"
                    Command="{Binding Library.ToggleSortDirectionCommand}"
                    ToolTip.Tip="Toggle sort direction"
                    VerticalAlignment="Center">
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                        Width="18" Height="18"/>
            </Button>
            <SplitButton Grid.Column="6"
                         Classes="primary"
                         ToolTip.Tip="Add a track"
                         VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <material:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                    <TextBlock Text="Add Track"/>
                </StackPanel>
                <SplitButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="10" Width="340" Margin="4">
                            <TextBlock FontWeight="SemiBold" Text="Add from URL"/>
                            <TextBox Text="{Binding Input.InputUrl, Mode=TwoWay}"
                                     PlaceholderText="Paste a YouTube, SoundCloud, or Spotify link..."/>
                            <Button Classes="primary" Content="Add"
                                    Command="{Binding Input.AddTrackCommand}"
                                    IsEnabled="{Binding Input.IsInputUrlValid}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                            <Button Classes="ghost" Content="Choose local file..."
                                    Command="{Binding Input.AddLocalFileCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"/>
                            <Button Classes="ghost" Content="Import a folder..."
                                    Command="{Binding Import.ImportFolderCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Flyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>
    </Border>

    <!--  COLUMN HEADERS  -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="48,*,150,80,110,36,36"
          Margin="16,8,16,2">
        <TextBlock Grid.Column="0" Classes="section-label"
                   Text="{Binding Library.ResultCountLabel}"
                   FontSize="{StaticResource FontSizeXs}"
                   Margin="4,0,0,0"/>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortByTitleCommand}"
                HorizontalContentAlignment="Left" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="TITLE / ARTIST" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                        Width="12" Height="12"
                                        IsVisible="{Binding Library.IsSortedByTitle}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortBySourceCommand}"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="SOURCE" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                        Width="12" Height="12"
                                        IsVisible="{Binding Library.IsSortedBySource}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortByPlayCountCommand}"
                HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="PLAYS" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                        Width="12" Height="12"
                                        IsVisible="{Binding Library.IsSortedByPlayCount}"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Command="{Binding Library.SortByDateCommand}"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="section-label" Text="ADDED" Margin="0"/>
                <material:MaterialIcon Kind="{Binding Library.SortAscending, Converter={StaticResource BoolToSortIcon}}"
                                        Width="12" Height="12"
                                        IsVisible="{Binding Library.IsSortedByDate}"/>
            </StackPanel>
        </Button>
    </Grid>

    <!--  TRACK LIST  -->
    <ListBox ItemsSource="{Binding Library.Tracks}"
             SelectedItem="{Binding Library.SelectedTrack}"
             Background="Transparent"
             Margin="8,0,8,8"
             SelectionChanged="OnTrackSelected"
             DoubleTapped="OnTrackDoubleTapped">
        <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem"
                          BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Play"
                                        Command="{Binding $parent[ListBox].DataContext.Library.PlayTrackCommand}"
                                        CommandParameter="{Binding}"/>
                                <MenuItem Header="View Details"
                                        Command="{Binding $parent[ListBox].DataContext.Library.OpenDetailCommand}"/>
                                <MenuItem Header="Toggle Favorite"
                                        Command="{Binding $parent[ListBox].DataContext.Library.ToggleFavoriteCommand}"/>
                                <MenuItem Header="Add to Queue"
                                        Command="{Binding $parent[ListBox].DataContext.Library.AddToQueueCommand}"/>
                                <MenuItem Header="Copy URL"
                                        Command="{Binding $parent[ListBox].DataContext.Library.CopyUrlCommand}"/>
                                <Separator/>
                                <MenuItem Header="Remove"
                                        Command="{Binding $parent[ListBox].DataContext.Library.RemoveTrackCommand}"
                                        CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
            </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:Track">
                <Grid ColumnDefinitions="48,*,150,80,110,36,36"
                      Margin="8,5" MinHeight="44">

                    <!-- Now-playing accent bar -->
                    <Border Grid.Column="0"
                            Width="3"
                            HorizontalAlignment="Left"
                            Margin="-8,-5,0,-5"
                            Background="{StaticResource BrushAccent}"
                            CornerRadius="0,2,2,0">
                        <Border.IsVisible>
                            <MultiBinding Converter="{StaticResource TrackIdEquals}">
                                <Binding Path="Id"/>
                                <Binding Path="$parent[ListBox].DataContext.Player.CurrentTrack.Id"/>
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>

                    <!-- Album art -->
                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="{StaticResource RadiusArt}"
                            Background="{StaticResource BrushSurface2}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Panel>
                            <Image Source="{Binding AlbumArtPath,
                                       Converter={StaticResource PathToBitmap}}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding AlbumArtPath,
                                       Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <material:MaterialIcon Kind="MusicNote"
                                       IsVisible="{Binding AlbumArtPath,
                                           Converter={x:Static ObjectConverters.IsNull}}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Width="18" Height="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Panel>
                    </Border>

                    <!-- Title + artist -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2"
                                Margin="10,0,8,0">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Source badge -->
                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Source,
                                Converter={StaticResource SourceToBg}}"/>
                        </Border.Background>
                        <TextBlock Text="{Binding Source}"
                                   Foreground="White"
                                   FontSize="{StaticResource FontSizeXs}"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Play count -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding PlayCount}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center"/>

                    <!-- Date added -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding DateAdded, StringFormat='{}{0:MMM dd, yyyy}'}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center"/>

                    <!-- Favorite star -->
                    <Button Grid.Column="5"
                            Classes="icon-btn"
                            Command="{Binding $parent[ListBox].DataContext.Library.ToggleFavoriteCommand}"
                            ToolTip.Tip="Toggle Favorite"
                            VerticalAlignment="Center">
                        <material:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToIconKind}, ConverterParameter='Star, StarOutline'}" 
                                               Width="18" Height="18" 
                                               Foreground="{StaticResource BrushAmber}" 
                                               Opacity="{Binding IsFavorite, Converter={StaticResource BoolToOpacity}}"/>
                    </Button>

                    <!-- More options -->
                    <Button Grid.Column="6"
                            Classes="icon-btn"
                            VerticalAlignment="Center"
                            ToolTip.Tip="More options">
                        <material:MaterialIcon Kind="DotsVertical" Width="18" Height="18"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Play"
                                          Command="{Binding $parent[ListBox].DataContext.Library.PlayTrackCommand}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="View Details"
                                          Command="{Binding $parent[ListBox].DataContext.Library.OpenDetailCommand}"/>
                                <MenuItem Header="Toggle Favorite"
                                          Command="{Binding $parent[ListBox].DataContext.Library.ToggleFavoriteCommand}"/>
                                <MenuItem Header="Add to Queue"
                                          Command="{Binding $parent[ListBox].DataContext.Library.AddToQueueCommand}"/>
                                <MenuItem Header="Copy URL"
                                          Command="{Binding $parent[ListBox].DataContext.Library.CopyUrlCommand}"/>
                                <Separator/>
                                <MenuItem Header="Remove"
                                          Command="{Binding $parent[ListBox].DataContext.Library.RemoveTrackCommand}"
                                          CommandParameter="{Binding}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</DockPanel>