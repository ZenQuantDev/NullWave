<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:attached="using:NullWave.Helpers.Attached"
             xmlns:converters="using:NullWave.Helpers.Converters"
             xmlns:loc="using:NullWave.Helpers.Localization"
             xmlns:services="using:NullWave.Services"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NullWave.Views.Controls.AppearanceWallpaperView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Resources>
    <converters:StringEqualsConverter x:Key="StrEq"/>
  </UserControl.Resources>

  <StackPanel Spacing="0">
    <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_Wallpaper}" Margin="0,0,0,12"/>
    <Border Classes="settings-card">
      <Grid ColumnDefinitions="220,24,*">
        <Border Grid.Column="0" Height="140" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True" Background="#0B1020" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
          <Grid>
            <Border IsHitTestVisible="False">
              <Border.Background>
                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.6" RadiusY="0.7">
                  <GradientStop Color="#6634D399" Offset="0"/>
                  <GradientStop Color="#0034D399" Offset="1"/>
                </RadialGradientBrush>
              </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
              <Border.Background>
                <RadialGradientBrush Center="0.85,0.2" GradientOrigin="0.85,0.2" RadiusX="0.5" RadiusY="0.6">
                  <GradientStop Color="#5938BDF8" Offset="0"/>
                  <GradientStop Color="#0038BDF8" Offset="1"/>
                </RadialGradientBrush>
              </Border.Background>
            </Border>
            <Image Source="{Binding Source={x:Static services:WallpaperService.Instance}, Path=Image}"
                   Stretch="UniformToFill"
                   IsVisible="{Binding Source={x:Static services:WallpaperService.Instance}, Path=ShowImage}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
              <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusFull}" Background="#22FFFFFF" HorizontalAlignment="Center">
                <material:MaterialIcon Kind="ImageOutline" Width="22" Height="22" Foreground="{DynamicResource BrushTextPrimary}"/>
              </Border>
              <Button Classes="chip" Command="{Binding SelectWallpaperCommand}" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <material:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                  <TextBlock Text="{loc:Loc Settings_Appearance_Wallpaper_Browse}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Border Background="{DynamicResource BrushAccentDim}" CornerRadius="{StaticResource RadiusSm}" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
              <TextBlock Text="{Binding WallpaperStatusLabel}" FontSize="{DynamicResource FontSizeXs}" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="1" Width="1" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center" Margin="0,4"/>

        <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc Settings_Appearance_Wallpaper_Source_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
            <WrapPanel>
              <Button Classes="chip" Command="{Binding SetWallpaperStyleCommand}" CommandParameter="None" Content="{loc:Loc Settings_Appearance_Wallpaper_Mode_None}" Margin="0,0,6,6">
                <attached:PseudoClass.Active><Binding Path="WallpaperStyle" Converter="{StaticResource StrEq}" ConverterParameter="None"/></attached:PseudoClass.Active>
              </Button>
              <Button Classes="chip" Command="{Binding SetWallpaperStyleCommand}" CommandParameter="Custom" Content="{loc:Loc Settings_Appearance_Wallpaper_Mode_Custom}" Margin="0,0,6,6">
                <attached:PseudoClass.Active><Binding Path="WallpaperStyle" Converter="{StaticResource StrEq}" ConverterParameter="Custom"/></attached:PseudoClass.Active>
              </Button>
              <Button Classes="chip" Command="{Binding SetWallpaperStyleCommand}" CommandParameter="AccentGlow" Content="{loc:Loc Settings_Appearance_Wallpaper_Mode_AccentGlow}" Margin="0,0,6,6">
                <attached:PseudoClass.Active><Binding Path="WallpaperStyle" Converter="{StaticResource StrEq}" ConverterParameter="AccentGlow"/></attached:PseudoClass.Active>
              </Button>
              <Button Classes="chip" Command="{Binding SetWallpaperStyleCommand}" CommandParameter="Scene" Content="{loc:Loc Settings_Appearance_Wallpaper_Mode_Scene}" Margin="0,0,6,6">
                <attached:PseudoClass.Active><Binding Path="WallpaperStyle" Converter="{StaticResource StrEq}" ConverterParameter="Scene"/></attached:PseudoClass.Active>
              </Button>
              <Button Classes="chip" Command="{Binding SetWallpaperStyleCommand}" CommandParameter="AlbumArt" Content="{loc:Loc Settings_Appearance_Wallpaper_Mode_AlbumArt}" IsEnabled="False" ToolTip.Tip="{loc:Loc Settings_Appearance_Wallpaper_AlbumArt_Soon}" Margin="0,0,6,6"/>
            </WrapPanel>
          </StackPanel>

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Grid.Column="0" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Loc Settings_Appearance_Wallpaper_Opacity}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                <TextBlock Grid.Column="1" Text="{Binding WallpaperOpacity, StringFormat='{}{0}%'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding WallpaperOpacity, Mode=TwoWay}" ToolTip.Tip="{loc:Loc Settings_Appearance_Wallpaper_OpacityTooltip}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Loc Settings_Appearance_Wallpaper_Blur}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                <TextBlock Grid.Column="1" Text="{Binding WallpaperSoftness}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
              </Grid>
              <Slider Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WallpaperSoftness, Mode=TwoWay}" ToolTip.Tip="{loc:Loc Settings_Appearance_Wallpaper_Blur_Desc}"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{loc:Loc Settings_Appearance_Wallpaper_Fit}" Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeSm}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Command="{Binding SetWallpaperFitCommand}" CommandParameter="Fill" Content="Cover">
                <attached:PseudoClass.Active><Binding Path="WallpaperFit" Converter="{StaticResource StrEq}" ConverterParameter="Fill"/></attached:PseudoClass.Active>
              </Button>
              <Button Classes="chip" Command="{Binding SetWallpaperFitCommand}" CommandParameter="Fit" Content="Fit">
                <attached:PseudoClass.Active><Binding Path="WallpaperFit" Converter="{StaticResource StrEq}" ConverterParameter="Fit"/></attached:PseudoClass.Active>
              </Button>
              <Button Classes="chip" Command="{Binding SetWallpaperFitCommand}" CommandParameter="Stretch" Content="Stretch">
                <attached:PseudoClass.Active><Binding Path="WallpaperFit" Converter="{StaticResource StrEq}" ConverterParameter="Stretch"/></attached:PseudoClass.Active>
              </Button>
            </StackPanel>
          </Grid>

          <Border Classes="settings-banner" Margin="0" IsVisible="{Binding ShowWallpaperTrueBlackWarning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{StaticResource BrushAmberDark}" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Loc Settings_Appearance_Wallpaper_TrueBlackWarn}" Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- BACKGROUND SCENES: procedural scenes + unlocked built-in art, one grid.
         Locked exclusives are absent from GalleryItems, so no lock overlay exists. -->
    <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Scenes_Title}" Margin="0,24,0,12"/>
    <Border Classes="settings-card">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding GalleryItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="5" Margin="0"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WallpaperGalleryItem">
              <Button Classes="card-select" Margin="4" Padding="0"
                      Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectWallpaperGalleryCommand}"
                      CommandParameter="{Binding Id}"
                      AutomationProperties.Name="{Binding Name}">
                <attached:PseudoClass.Active>
                  <MultiBinding Converter="{x:Static converters:StringEqualsMultiConverter.Instance}">
                    <Binding Path="$parent[UserControl].((vm:SettingsViewModel)DataContext).WallpaperSelectionKey"/>
                    <Binding Path="Id"/>
                  </MultiBinding>
                </attached:PseudoClass.Active>
                <Grid RowDefinitions="80,Auto">
                  <Border Grid.Row="0" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True">
                    <Panel>
                      <Border Background="{DynamicResource BrushSurface2}"/>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=aurora}">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="{DynamicResource ColorAccentDim}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=horizon}">
                        <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                          <GradientStop Color="{DynamicResource ColorAccent2Glow}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccentDim}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=spotlight}">
                        <Border.Background><RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1">
                          <GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccentDim}" Offset="0.5"/><GradientStop Color="{DynamicResource ColorBase}" Offset="1"/>
                        </RadialGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=duotone}">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccent2Glow}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=dusk}">
                        <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                          <GradientStop Color="{DynamicResource ColorAccentDim}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccent2Dim}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=forest}">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="{DynamicResource ColorAccentDim}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=seaside}">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="{DynamicResource ColorAccent2Glow}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=bloom}">
                        <Border.Background><RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                          <GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccent2Dim}" Offset="1"/>
                        </RadialGradientBrush></Border.Background>
                      </Border>
                      <Border IsVisible="{Binding Id, Converter={StaticResource StrEq}, ConverterParameter=abstract}">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="0"/><GradientStop Color="{DynamicResource ColorAccent2Glow}" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                      </Border>
                      <Image Source="{Binding AssetPath, Converter={x:Static converters:AssetThumbConverter.Instance}}"
                             Stretch="UniformToFill"
                             IsVisible="{Binding AssetPath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Row="1" Spacing="2" Margin="8,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" MaxLines="2"/>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0"
                    IsVisible="{Binding Source={x:Static services:WallpaperService.Instance}, Path=MinimalTier}">
          <material:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                 Foreground="{StaticResource BrushAmberDark}" VerticalAlignment="Center"/>
          <TextBlock Text="{loc:Loc Settings_Appearance_Scenes_LowPowerHint}"
                     Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>