<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        x:Class="NullWave.Views.Controls.ImportProgressView"
        x:DataType="vm:MainViewModel"
        Background="{StaticResource BrushGreenDim}"
        BorderBrush="{StaticResource BrushGreen}"
        BorderThickness="0,1,0,0"
        Padding="16,8"
        IsVisible="{Binding Import.IsImporting}">

    <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{Binding Import.ImportStatus}"
                       Foreground="{StaticResource BrushGreen}"
                       FontSize="{StaticResource FontSizeBody}"
                       FontWeight="SemiBold"/>
            <ProgressBar Value="{Binding Import.ImportProgress}"
                         Maximum="{Binding Import.ImportTotal}"
                         Height="4"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="{StaticResource FontSizeSm}">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} / {1}">
                    <Binding Path="Import.ImportProgress"/>
                    <Binding Path="Import.ImportTotal"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </Grid>

</Border>