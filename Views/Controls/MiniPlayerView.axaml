<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:converters="using:NullWave.Helpers.Converters"
        x:Class="NullWave.Views.Controls.MiniPlayerView"
        x:DataType="vm:MainViewModel"
        Background="{StaticResource BrushSurface}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="0,1,0,0"
        Height="90"
        Padding="16,0">

    <Border.Resources>
        <converters:FilePathToBitmapConverter x:Key="PathToBitmap"/>
    </Border.Resources>

    <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Stretch">

        <!-- ── LEFT: Art + track info + favorite ─────────────────────── -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="12">
            <Border Width="52" Height="52"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{StaticResource BrushElevated}"
                    ClipToBounds="True">
                <Panel>
                    <Image Source="{Binding Player.AlbumArtPath,
                               Converter={StaticResource PathToBitmap}}"
                           IsVisible="{Binding Player.HasAlbumArt}"
                           Stretch="UniformToFill"/>
                    <TextBlock Text="♪"
                               IsVisible="{Binding !Player.HasAlbumArt}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeXl}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Panel>
            </Border>

            <StackPanel VerticalAlignment="Center" Spacing="3" MaxWidth="200">
                <TextBlock Text="{Binding Player.CurrentTrackDisplay}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Player.StatusText}"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeXs}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Classes="player-btn"
                    Content="★"
                    Foreground="{StaticResource BrushAmber}"
                    Command="{Binding Player.ToggleCurrentFavoriteCommand}"
                    ToolTip.Tip="Toggle Favorite"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── CENTER: Controls + seek (fixed 440px) ─────────────────── -->
        <StackPanel Grid.Column="1"
                    Width="440"
                    VerticalAlignment="Center"
                    Spacing="8">

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <!-- UPDATED: Shuffle button with dynamic foreground -->
                <Button Classes="player-btn"
                        Content="{Binding Player.ShuffleIcon}"
                        Command="{Binding Player.ToggleShuffleCommand}"
                        Foreground="{Binding Player.ShuffleForeground}"
                        ToolTip.Tip="Shuffle"/>

                <Button Classes="player-btn"
                        Content="⏮"
                        Command="{Binding Player.PreviousTrackCommand}"
                        ToolTip.Tip="Previous (P)"/>

                <Button Classes="player-btn"
                        Content="-5"
                        Command="{Binding Player.SeekBackwardCommand}"
                        FontSize="12"
                        ToolTip.Tip="Back 5s (←)"/>

                <!-- Play/pause — white circle, dark icon -->
                <Button Classes="player-btn play"
                        Content="{Binding Player.PlayPauseIcon}"
                        Command="{Binding Player.PlayPauseCommand}"
                        ToolTip.Tip="Play / Pause (Space)"/>

                <Button Classes="player-btn"
                        Content="+5"
                        Command="{Binding Player.SeekForwardCommand}"
                        FontSize="12"
                        ToolTip.Tip="Forward 5s (→)"/>

                <Button Classes="player-btn"
                        Content="⏭"
                        Command="{Binding Player.NextTrackCommand}"
                        ToolTip.Tip="Next (N)"/>

                <!-- UPDATED: Repeat button with dynamic foreground -->
                <Button Classes="player-btn"
                        Content="{Binding Player.RepeatIcon}"
                        Command="{Binding Player.CycleRepeatCommand}"
                        Foreground="{Binding Player.RepeatForeground}"
                        ToolTip.Tip="Repeat mode"/>
            </StackPanel>

            <!-- Seek row -->
            <Grid ColumnDefinitions="36,*,36">
                <TextBlock Grid.Column="0"
                           Text="{Binding Player.PositionDisplay}"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeXs}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,0"/>
                <Slider Grid.Column="1"
                        x:Name="SeekSlider"
                        Value="{Binding Player.Position, Mode=OneWay}"
                        Minimum="0" Maximum="1"
                        VerticalAlignment="Center"
                        PointerPressed="OnSeekPressed"
                        PointerReleased="OnSeekReleased"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Player.DurationDisplay}"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeXs}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- ── RIGHT: Volume ──────────────────────────────────────────── -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding Player.IsDownloading}"
                        VerticalAlignment="Center">
                <TextBlock Text="Downloading"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeXs}"
                           VerticalAlignment="Center"/>
                <ProgressBar Value="{Binding Player.DownloadProgress}"
                             Maximum="1" Width="60" Height="2"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <Button Classes="player-btn"
                    Content="{Binding Player.VolumeIcon}"
                    Command="{Binding Player.ToggleMuteCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Mute / Unmute (M)"/>

            <Slider Value="{Binding Player.Volume, Mode=TwoWay}"
                    Minimum="0" Maximum="1" Width="90"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Volume"/>
        </StackPanel>
    </Grid>
</Border>