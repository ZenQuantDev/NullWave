<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:models="using:NullWave.Models"
        x:Class="NullWave.Views.AddToPlaylistDialog"
        Title="Add to Playlist" Width="380" Height="460"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{StaticResource BrushBase}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="ADD TO PLAYLIST" Margin="0,0,0,8"/>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" PlaceholderText="Search playlists..." TextChanged="OnSearchChanged"/>
            <Button Grid.Column="1" Classes="primary" Content="New" Margin="8,0,0,0"
                    Click="OnNewPlaylist" ToolTip.Tip="Create a new playlist and add to it"/>
        </Grid>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,10,0,0">
            <Button Grid.Column="2" Classes="secondary" Content="Cancel" Click="OnCancel" Padding="16,8"/>
            <Button Grid.Column="4" Classes="primary" Content="Add" Click="OnOk" Padding="16,8"/>
        </Grid>
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
            <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Playlist">
                        <Grid ColumnDefinitions="Auto,*" Margin="2,4">
                            <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSm}"
                                    Background="{StaticResource BrushAccentDim}" Margin="0,0,10,0">
                                <material:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18"
                                        Foreground="{StaticResource BrushAccent}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Tracks.Count, StringFormat='{}{0} tracks'}"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>