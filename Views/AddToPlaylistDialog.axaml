<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:models="using:NullWave.Models"
        xmlns:loc="using:NullWave.Helpers.Localization"
        x:Class="NullWave.Views.AddToPlaylistDialog"
        Title="{loc:Loc Dialog_AddToPlaylist_Title}" Width="380" Height="460"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="{StaticResource BrushBase}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="{loc:Loc Dialog_AddToPlaylist_Section}" Margin="0,0,0,8"/>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" PlaceholderText="{loc:Loc Dialog_AddToPlaylist_SearchPlaceholder}" TextChanged="OnSearchChanged"/>
            <Button Grid.Column="1" Classes="primary" Content="{loc:Loc Dialog_AddToPlaylist_NewButton}" Margin="8,0,0,0"
                    Click="OnNewPlaylist" ToolTip.Tip="{loc:Loc Dialog_AddToPlaylist_NewTooltip}"/>
        </Grid>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,10,0,0">
            <Button Grid.Column="2" Classes="secondary" Content="{loc:Loc Dialog_Cancel}" Click="OnCancel" Padding="16,8"/>
            <Button Grid.Column="4" Classes="primary" Content="{loc:Loc Dialog_Add}" Click="OnOk" Padding="16,8"/>
        </Grid>
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
            <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Playlist">
                        <Grid ColumnDefinitions="Auto,*" Margin="2,4">
                            <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSm}"
                                    Background="{StaticResource BrushAccentDim}" Margin="0,0,10,0">
                                <material:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18"
                                        Foreground="{StaticResource BrushAccent}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Tracks.Count}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                    <TextBlock Text="{loc:Loc Dialog_Tracks_Word}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>