<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:controls="using:NullWave.Views.Controls"
        xmlns:converters="using:NullWave.Helpers.Converters"
        xmlns:services="using:NullWave.Services"
        xmlns:models="using:NullWave.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="NullWave.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NullWave"
        MinWidth="1150" MinHeight="620"
        Width="1280" Height="780"
        Background="{StaticResource BrushBase}"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <converters:BoolToDoubleConverter x:Key="BoolToDouble"/>
    </Window.Resources>
    
    <Window.Styles>
        <!-- Base layout styles for all toasts -->
        <Style Selector="Border.success, Border.error, Border.warning, Border.info">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Theme-mapped colors using your shared resources -->
        <Style Selector="Border.success">
            <Setter Property="Background" Value="{DynamicResource BrushGreenDim}"/>
        </Style>
        <Style Selector="Border.error">
            <Setter Property="Background" Value="{DynamicResource BrushRedDim}"/>
        </Style>
        <Style Selector="Border.warning">
            <Setter Property="Background" Value="{DynamicResource BrushAmberDim}"/>
        </Style>
        <Style Selector="Border.info">
            <Setter Property="Background" Value="{DynamicResource BrushBase}"/>
        </Style>
    </Window.Styles>

    <Panel>
        <DockPanel>
            <controls:MenuBarView DockPanel.Dock="Top" IsVisible="{Binding IsMenuBarVisible}"/>
            <controls:MiniPlayerView DockPanel.Dock="Bottom"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToGridLength}, ConverterParameter='0,220'}"
                                      MinWidth="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToDouble}, ConverterParameter='180,0'}"
                                      MaxWidth="350"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="700"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="{Binding ActiveRightPanelWidth}"/>
                </Grid.ColumnDefinitions>

                <controls:SidebarView Grid.Column="0" IsVisible="{Binding !IsSidebarCollapsed}"/>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="True"
                              IsVisible="{Binding !IsSidebarCollapsed}"/>
                              
                <Grid Grid.Column="2">
                    <controls:TrackListView
                        IsVisible="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Library}"/>
                    <controls:PlaylistsView
                        IsVisible="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Playlists}"/>

                    <Button Classes="icon-btn"
                            Command="{Binding ToggleSidebarCollapsedCommand}"
                            IsVisible="{Binding IsSidebarCollapsed}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Background="{StaticResource BrushSurface2}"
                            ToolTip.Tip="Show sidebar">
                        <materialIcons:MaterialIcon Kind="{Binding SidebarCollapseIconKind}" Width="18" Height="18"/>
                    </Button>
                </Grid>
                
                <controls:TrackDetailView Grid.Column="4" IsVisible="{Binding Detail.IsOpen}"/>
                <controls:QueueView Grid.Column="4" IsVisible="{Binding Queue.IsOpen}"/>
            </Grid>
        </DockPanel>
        
        <!-- THE TOAST OVERLAY LAYER -->
        <ItemsControl ItemsSource="{Binding ActiveToasts}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,24,24"
                      IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:LiveNotification">
                    <Border Width="360"
                            Margin="0,2"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            BoxShadow="0 4 20 0 #55000000"
                            ClipToBounds="True">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Style.Animations>
                                    <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Forward">
                                        <KeyFrame KeyTime="0:0:0">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="TranslateTransform.Y" Value="15"/>
                                        </KeyFrame>
                                        <KeyFrame KeyTime="0:0:0.25">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="TranslateTransform.Y" Value="0"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Width="5"
                                    VerticalAlignment="Stretch"
                                    Background="{Binding NotificationColor}"/>
                            
                            <StackPanel Grid.Column="1" Margin="14,12" Spacing="6">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Path Grid.Column="0"
                                          Width="15" Height="15"
                                          Margin="0,0,8,0"
                                          Fill="{Binding NotificationColor}"
                                          Data="{Binding IconData}"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                    
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <Button Grid.Column="2"
                                            Command="{Binding CloseCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4" MinWidth="0" MinHeight="0"
                                            Cursor="Hand">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Style>
                                        </Button.Styles>
                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                    Foreground="{StaticResource BrushTextMuted}"/>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding Message}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="23,0,0,2"/>

                                <ProgressBar IsVisible="{Binding ShowProgressBar}"
                                             Value="{Binding ProgressValue}"
                                             IsIndeterminate="{Binding IsIndeterminate}"
                                             Height="4"
                                             Margin="23,2,0,2"
                                             CornerRadius="2"
                                             Background="{StaticResource BrushBorder}"
                                             Foreground="{Binding NotificationColor}"/>

                                <Button IsVisible="{Binding ShowActionButton}"
                                        Command="{Binding ActionCommand}"
                                        Content="{Binding ActionButtonText}"
                                        HorizontalAlignment="Right"
                                        FontSize="{StaticResource FontSizeXs}" 
                                        Padding="10,4"
                                        Background="{StaticResource BrushSurface2}"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        CornerRadius="6"/>

                                <StackPanel IsVisible="{Binding HasDetailedMessage}" Margin="23,2,0,0">
                                    <Button Command="{Binding ToggleExpandCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Left" Cursor="Hand">
                                        <Panel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsExpanded}">
                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Show details" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsExpanded}">
                                                <materialIcons:MaterialIcon Kind="ChevronUp" Width="14" Height="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Hide details" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Panel>
                                    </Button>
                                    
                                    <Border IsVisible="{Binding IsExpanded}"
                                            Margin="0,6,0,0" Padding="8"
                                            Background="{StaticResource BrushBase}"
                                            CornerRadius="6"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1">
                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding DetailedMessage}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>