<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="NullWave.Views.Settings.AdvancedTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <!--  Logging  -->
            <TextBlock Classes="section-label" Text="LOGGING" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Advanced / Verbose logging" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <Button Classes="help-btn" ToolTip.Tip="Default mode logs summaries only. Advanced mode also logs every individual item. Takes effect immediately.">
                                <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding LoggingModeLabel, StringFormat='Current mode: {0}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerboseLogging}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!--  Data Folders  -->
            <TextBlock Classes="section-label" Text="DATA" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Open data folder" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="~/.nullwave - keys, db, downloads, art, logs" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="Open folder" Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Open logs folder" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="~/.nullwave/logs - system, user actions, errors" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="Open folder" Command="{Binding OpenLogsFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Download Behavior  -->
            <TextBlock Classes="section-label" Text="DOWNLOAD BEHAVIOR" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Block Duplicate Downloads" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                        <TextBlock Text="Quickly scan the database to skip incoming tracks that already exist in the library." Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding PreventDuplicateDownloads}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!--  Download Speed & Auth  -->
            <TextBlock Classes="section-label" Text="DOWNLOAD SPEED &amp; AUTH" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Use aria2c for downloads" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="Delegates the download itself to aria2c, opening 16 concurrent connections per track for much faster transfers.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Multi-connection downloads via aria2c (falls back silently if not installed)" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseAria2c}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Browser cookies" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="Passes --cookies-from-browser to yt-dlp so requests look like they come from a logged-in browser session.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Bypasses aggressive rate limiting and shortens inter-track delay" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BrowserCookieOptions}" SelectedItem="{Binding YtDlpBrowserCookies, Mode=TwoWay}" MinWidth="130" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Danger Zone  -->
            <TextBlock Classes="section-label" Text="DANGER ZONE" Foreground="{StaticResource BrushRed}" Margin="0,0,0,12"/>
            <Border Classes="settings-card" BorderBrush="{StaticResource BrushRed}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Delete API keys" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="Securely wipes all stored API keys from keys.enc" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="Delete keys" Command="{Binding DeleteApiKeysCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Delete logs" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="Securely wipes all log files" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="Delete logs" Command="{Binding DeleteLogsCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Wipe everything" Foreground="{StaticResource BrushRed}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="Bold"/>
                            <TextBlock Text="Permanently deletes all keys, logs, downloads, and NullWave data. Cannot be undone." Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeXs}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="Wipe everything" Command="{Binding DeleteEverythingCommand}" Margin="16,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>