<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.AdvancedTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <!-- LOGGING -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Logging}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Verbose_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Advanced_Verbose_Tooltip}">
                                <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding LoggingModeLabel}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerboseLogging}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- DATA -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Data}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenData}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenData_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Advanced_OpenData}" Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenLogs}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenLogs_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Advanced_OpenLogs}" Command="{Binding OpenLogsFolderCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Backup_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Backup_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Advanced_Backup_Button}" Command="{Binding BackupDatabaseCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DOWNLOAD BEHAVIOR -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Behavior}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_BlockDup_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_BlockDup_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PreventDuplicateDownloads}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Audio_Concurrent_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Audio_Concurrent_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrentDownloadOptions}" SelectedItem="{Binding MaxConcurrentDownloads}" MinWidth="80" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DOWNLOAD SPEED & AUTH -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Speed}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Advanced_Aria2_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Advanced_Aria2_Tooltip}">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Aria2_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseAria2c}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Advanced_Cookies_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Advanced_Cookies_Tooltip}">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Cookies_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BrowserCookieOptions}" SelectedItem="{Binding YtDlpBrowserCookies, Mode=TwoWay}" MinWidth="130" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- NETWORK & PROXY -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Network}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Proxy_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Proxy_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding YtDlpProxy, Mode=TwoWay}" PlaceholderText="{loc:Loc Settings_Advanced_Proxy_Placeholder}"/>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Geo_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Geo_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding YtDlpGeoProxy, Mode=TwoWay}" PlaceholderText="{loc:Loc Settings_Advanced_Geo_Placeholder}"/>
                </StackPanel>
            </Border>

            <!-- DANGER ZONE -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Danger}" Foreground="{StaticResource BrushRed}" Margin="0,0,0,12"/>
            <Border Classes="settings-card" BorderBrush="{StaticResource BrushRed}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteKeys_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteKeys_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_DeleteKeys_Button}" Command="{Binding DeleteApiKeysCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteLogs_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteLogs_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_DeleteLogs_Button}" Command="{Binding DeleteLogsCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Reset_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Reset_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_Reset_Button}" Command="{Binding ResetPreferencesCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Wipe_Title}" Foreground="{StaticResource BrushRed}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Wipe_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_Wipe_Button}" Command="{Binding DeleteEverythingCommand}" Margin="16,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>