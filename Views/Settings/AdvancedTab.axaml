<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             x:Class="NullWave.Views.Settings.AdvancedTab"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="20">

            <TextBlock Classes="section-label" Text="DATA" Margin="0"/>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Open data folder"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeBodyLarge}"/>
                    <TextBlock Text="~/.nullwave — keys, db, downloads, art, logs"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary"
                        Content="Open folder"
                        Command="{Binding OpenDataFolderCommand}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Open logs folder"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeBodyLarge}"/>
                    <TextBlock Text="~/.nullwave/logs — system, user actions, errors"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary"
                        Content="Open folder"
                        Command="{Binding OpenLogsFolderCommand}"/>
            </Grid>

            <!-- NEW: Clear thumbnails -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Clear cached thumbnails"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeBodyLarge}"/>
                    <TextBlock Text="Deletes all cached album art and re-fetches it automatically"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary"
                        Content="Clear thumbnails"
                        Command="{Binding ClearThumbnailsCommand}"/>
            </Grid>

            <TextBlock Text="{Binding ThumbnailStatus}"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="{StaticResource FontSizeXs}"
                       IsVisible="{Binding ThumbnailStatus,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Separator Background="{StaticResource BrushBorder}"/>
            <TextBlock Classes="section-label" Text="DANGER ZONE" Margin="0"
                       Foreground="{StaticResource BrushRed}"/>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Delete API keys"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeBodyLarge}"/>
                    <TextBlock Text="Securely wipes all stored API keys from keys.enc"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="danger"
                        Content="Delete keys"
                        Command="{Binding DeleteApiKeysCommand}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Delete logs"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeBodyLarge}"/>
                    <TextBlock Text="Securely wipes all log files"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="danger"
                        Content="Delete logs"
                        Command="{Binding DeleteLogsCommand}"/>
            </Grid>

            <Border Background="{StaticResource BrushRedDim}"
                    CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{StaticResource BrushRed}"
                    BorderThickness="1"
                    Padding="14,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Wipe everything"
                                   Foreground="{StaticResource BrushRed}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Permanently deletes all keys, logs, downloads, and NullWave data. Cannot be undone."
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="danger"
                            Content="Wipe everything"
                            Command="{Binding DeleteEverythingCommand}"
                            Margin="16,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>