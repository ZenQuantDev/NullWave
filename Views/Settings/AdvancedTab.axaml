<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="NullWave.Views.Settings.AdvancedTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">
            
            <!--  Data Folders  -->
            <TextBlock Classes="section-label" Text="DATA" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Open data folder"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="~/.nullwave - keys, db, downloads, art, logs"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Open folder"
                                Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Open logs folder"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="~/.nullwave/logs - system, user actions, errors"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Open folder"
                                Command="{Binding OpenLogsFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Metadata Engine  -->
            <TextBlock Classes="section-label" Text="METADATA ENGINE" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="AI Metadata Cleaning"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Automatically remove clutter like 'ft.', '(Official)', or '- Topic' from track data."
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" 
                                  IsChecked="{Binding AutoCleanMetadata}" 
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!--  Download Behavior  -->
            <TextBlock Classes="section-label" Text="DOWNLOAD BEHAVIOR" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Block Duplicate Downloads"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Quickly scan the database to skip incoming tracks that already exist in the library."
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" 
                                  IsChecked="{Binding PreventDuplicateDownloads}" 
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!--  Download Speed & Auth  -->
            <TextBlock Classes="section-label" Text="DOWNLOAD SPEED &amp; AUTH" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Use aria2c for downloads"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Delegates the download itself to aria2c, opening 16 concurrent connections per track for much faster transfers. Requires aria2c to be installed and on PATH — NullWave falls back to yt-dlp's built-in downloader automatically if it isn't found.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Multi-connection downloads via aria2c (falls back silently if not installed)"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding UseAria2c}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Browser cookies"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Passes --cookies-from-browser to yt-dlp so requests look like they come from a logged-in browser session. This significantly reduces YouTube rate-limiting and shortens the delay between playlist tracks. Choose the browser you're actively signed into YouTube with.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Bypasses aggressive rate limiting and shortens inter-track delay"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BrowserCookieOptions}"
                                  SelectedItem="{Binding YtDlpBrowserCookies, Mode=TwoWay}"
                                  MinWidth="130"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Library Maintenance  -->
            <TextBlock Classes="section-label" Text="LIBRARY MAINTENANCE" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Repair file paths"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Scans all tracks with a saved file path and checks if the file still exists on disk. Missing files have their path cleared so NullWave knows to re-download them.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Scan library for tracks whose audio file no longer exists on disk"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Repair Paths"
                                Command="{Binding RepairPathsCommand}"
                                IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Reimport assets"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Scans your download folder for audio files and re-links them to matching library tracks. Useful after moving files or clearing paths.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Scan download folder and re-link audio files to existing tracks"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Reimport Assets"
                                Command="{Binding ReimportAssetsCommand}"
                                IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Force metadata re-sync"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Clears all cached tags from every track and re-runs the Last.fm enrichment pipeline to fetch fresh genre and mood tags.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Clear cached tags and re-fetch from Last.fm for all tracks"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Re-sync Metadata"
                                Command="{Binding ForceMetaResyncCommand}"
                                IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Sweep orphaned files"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Deletes audio files in your downloads folder that no library track points to. Use Preview first to see the count without deleting anything.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Delete .mp3/.m4a files with no matching library entry"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Content="Preview"
                                    Command="{Binding PreviewOrphanedFilesCommand}"
                                    IsEnabled="{Binding !IsRepairing}"/>
                            <Button Classes="danger" Content="Sweep"
                                    Command="{Binding SweepOrphanedFilesCommand}"
                                    IsEnabled="{Binding !IsRepairing}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Repair status feedback -->
                    <Border Background="{StaticResource BrushElevated}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,8"
                            IsVisible="{Binding RepairStatus,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="InformationOutline"
                                                   Width="14" Height="14"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RepairStatus}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sweep status feedback (separate property from RepairStatus) -->
                    <Border Background="{StaticResource BrushElevated}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,8"
                            IsVisible="{Binding SweepStatus,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="InformationOutline"
                                                   Width="14" Height="14"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SweepStatus}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Cache  -->
            <TextBlock Classes="section-label" Text="CACHE" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Clear cached thumbnails"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Deletes all cached album art and re-fetches it automatically"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Clear thumbnails"
                                Command="{Binding ClearThumbnailsCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding ThumbnailStatus}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeXs}"
                               IsVisible="{Binding ThumbnailStatus,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Clear yt-dlp cache"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Purges yt-dlp download caches to fix stale streams and extractor errors"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Clear cache"
                                Command="{Binding ClearYtDlpCacheCommand}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <!--  Database Vacuum / Optimize  -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Optimize database"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Runs SQLite's VACUUM command to shrink the database file and speed up queries after many inserts and deletes. Briefly locks the database, so avoid running this mid-download.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Shrinks the database file and speeds up queries"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary"
                                Content="Optimize"
                                Command="{Binding VacuumDatabaseCommand}"
                                IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <TextBlock Text="{Binding VacuumStatus}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeXs}"
                               IsVisible="{Binding VacuumStatus,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!--  Danger Zone  -->
            <TextBlock Classes="section-label" Text="DANGER ZONE"
                       Foreground="{StaticResource BrushRed}"
                       Margin="0,0,0,12"/>
            <Border Classes="settings-card"
                    BorderBrush="{StaticResource BrushRed}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Delete API keys"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Securely wipes all stored API keys from keys.enc"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger"
                                Content="Delete keys"
                                Command="{Binding DeleteApiKeysCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Delete logs"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Securely wipes all log files"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger"
                                Content="Delete logs"
                                Command="{Binding DeleteLogsCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Wipe everything"
                                       Foreground="{StaticResource BrushRed}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Permanently deletes all keys, logs, downloads, and NullWave data. Cannot be undone."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger"
                                Content="Wipe everything"
                                Command="{Binding DeleteEverythingCommand}"
                                Margin="16,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>