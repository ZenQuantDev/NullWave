<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:converters="using:NullWave.Helpers.Converters"
             xmlns:attached="using:NullWave.Helpers.Attached"
             xmlns:services="using:NullWave.Services"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.AppearanceTab"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StrEq"/>
        <converters:BoolToDimConverter x:Key="BoolToDim"/>
    </UserControl.Resources>

    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <!-- SIGNATURE EDITION -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_Signature}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Button Classes="flat" Command="{Binding SetAccentCommand}" CommandParameter="Oxeye Daisy">
                    <attached:PseudoClass.Active>
                        <Binding Path="AccentColor" Converter="{StaticResource StrEq}" ConverterParameter="Oxeye Daisy"/>
                    </attached:PseudoClass.Active>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource BrushAccentGradient}">
                            <material:MaterialIcon Kind="Flower" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Appearance_Signature_Title}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_Signature_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Width="22" Height="22" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource BrushAccent}"
                                IsVisible="{Binding AccentColor, Converter={StaticResource StrEq}, ConverterParameter='Oxeye Daisy'}">
                            <material:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{StaticResource BrushTextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
            </Border>

            <!-- BASE COLORS -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_BaseColors}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <ItemsControl ItemsSource="{Binding Source={x:Static services:ThemeService.BaseAccents}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ThemeService+AccentDef">
                            <Button Classes="duo-chip"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetAccentCommand}"
                                    CommandParameter="{Binding Name}"
                                    Margin="0,0,8,8">
                                <attached:PseudoClass.Active>
                                    <MultiBinding Converter="{x:Static converters:StringEqualsMultiConverter.Instance}">
                                        <Binding Path="$parent[ItemsControl].((vm:SettingsViewModel)DataContext).AccentColor"/>
                                        <Binding Path="Name"/>
                                    </MultiBinding>
                                </attached:PseudoClass.Active>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{Binding PrimaryBrush}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ACCENT DUOS -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_AccentDuos}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <ItemsControl ItemsSource="{x:Static services:ThemeService.DuotoneAccents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ThemeService+AccentDef">
                            <Button Classes="duo-chip"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetAccentCommand}"
                                    CommandParameter="{Binding Name}"
                                    Margin="0,0,8,8">
                                <attached:PseudoClass.Active>
                                    <MultiBinding Converter="{x:Static converters:StringEqualsMultiConverter.Instance}">
                                        <Binding Path="$parent[ItemsControl].((vm:SettingsViewModel)DataContext).AccentColor"/>
                                        <Binding Path="Name"/>
                                    </MultiBinding>
                                </attached:PseudoClass.Active>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{Binding SplitGradient}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>


<!-- THEME MODE -->
            <TextBlock Classes="section-label" Text="THEME MODE" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="chip" Command="{Binding SetThemeModeCommand}" CommandParameter="Dark" Content="Dark">
                            <attached:PseudoClass.Active><Binding Path="ThemeMode" Converter="{StaticResource StrEq}" ConverterParameter="Dark"/></attached:PseudoClass.Active>
                        </Button>
                        <Button Classes="chip" Command="{Binding SetThemeModeCommand}" CommandParameter="Light" Content="Light">
                            <attached:PseudoClass.Active><Binding Path="ThemeMode" Converter="{StaticResource StrEq}" ConverterParameter="Light"/></attached:PseudoClass.Active>
                        </Button>
                        <Button Classes="chip" Command="{Binding SetThemeModeCommand}" CommandParameter="System" Content="System">
                            <attached:PseudoClass.Active><Binding Path="ThemeMode" Converter="{StaticResource StrEq}" ConverterParameter="System"/></attached:PseudoClass.Active>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PROFILE FRAME -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_ProfileFrame}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc Settings_Appearance_ProfileFrame_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="chip" Command="{Binding SetProfileFrameCommand}" CommandParameter="None" Content="{loc:Loc Settings_Appearance_Frame_None}">
                            <attached:PseudoClass.Active><Binding Path="ProfileFrameStyle" Converter="{StaticResource StrEq}" ConverterParameter="None"/></attached:PseudoClass.Active>
                        </Button>
                        <Button Classes="chip" Command="{Binding SetProfileFrameCommand}" CommandParameter="Ring" Content="{loc:Loc Settings_Appearance_Frame_Ring}">
                            <attached:PseudoClass.Active><Binding Path="ProfileFrameStyle" Converter="{StaticResource StrEq}" ConverterParameter="Ring"/></attached:PseudoClass.Active>
                        </Button>
                        <Button Classes="chip" Command="{Binding SetProfileFrameCommand}" CommandParameter="Glow" Content="{loc:Loc Settings_Appearance_Frame_Glow}">
                            <attached:PseudoClass.Active><Binding Path="ProfileFrameStyle" Converter="{StaticResource StrEq}" ConverterParameter="Glow"/></attached:PseudoClass.Active>
                        </Button>
                    </StackPanel>

                    <Border Classes="settings-banner" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                   Foreground="{StaticResource BrushAmberDark}" VerticalAlignment="Center"/>
                            <TextBlock Text="Experimental: Profile Frames are still being polished - Ring and Glow can render inconsistently or glitch, especially after theme or accent changes. If something looks off, switch back to None for now."
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TRACK ROW STYLE -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_TrackRowStyle}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,16,*,16,*" IsEnabled="{Binding !CompactMode}" Opacity="{Binding CompactMode, Converter={StaticResource BoolToDim}}">
                    <Button Grid.Column="0" Classes="card-select" Command="{Binding SetRowStyleCommand}" CommandParameter="Comfortable" ToolTip.Tip="{loc:Loc Settings_Appearance_RowStyle_Disabled_Tooltip}">
                        <attached:PseudoClass.Active><Binding Path="TrackRowStyle" Converter="{StaticResource StrEq}" ConverterParameter="Comfortable"/></attached:PseudoClass.Active>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc Settings_Appearance_RowStyle_Comfortable}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}"/>
                            <Border Height="6" Background="{StaticResource BrushBorder}" CornerRadius="{StaticResource RadiusXs}"/>
                            <Border Height="6" Background="{StaticResource BrushBorder}" CornerRadius="{StaticResource RadiusXs}" Width="50" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_RowStyle_Comfortable_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="card-select" Command="{Binding SetRowStyleCommand}" CommandParameter="Compact" ToolTip.Tip="{loc:Loc Settings_Appearance_RowStyle_Disabled_Tooltip}">
                        <attached:PseudoClass.Active><Binding Path="TrackRowStyle" Converter="{StaticResource StrEq}" ConverterParameter="Compact"/></attached:PseudoClass.Active>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Settings_Appearance_RowStyle_Compact}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}"/>
                            <Border Height="5" Background="{StaticResource BrushBorder}" CornerRadius="{StaticResource RadiusXs}"/>
                            <Border Height="5" Background="{StaticResource BrushBorder}" CornerRadius="{StaticResource RadiusXs}" Width="40" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_RowStyle_Compact_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="card-select" Command="{Binding SetRowStyleCommand}" CommandParameter="Cozy" ToolTip.Tip="{loc:Loc Settings_Appearance_RowStyle_Disabled_Tooltip}">
                        <attached:PseudoClass.Active><Binding Path="TrackRowStyle" Converter="{StaticResource StrEq}" ConverterParameter="Cozy"/></attached:PseudoClass.Active>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc Settings_Appearance_RowStyle_Cozy}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}"/>
                            <Border Height="8" Background="{StaticResource BrushBorder}" CornerRadius="{StaticResource RadiusXs}"/>
                            <Border Height="8" Background="{StaticResource BrushBorder}" CornerRadius="{StaticResource RadiusXs}" Width="60" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_RowStyle_Cozy_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- DISPLAY -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Appearance_Section_Display}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Appearance_FontScale_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_FontScale_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="chip" Command="{Binding SetFontScaleCommand}" CommandParameter="Small" Content="S">
                                <attached:PseudoClass.Active><Binding Path="FontScale" Converter="{StaticResource StrEq}" ConverterParameter="Small"/></attached:PseudoClass.Active>
                            </Button>
                            <Button Classes="chip" Command="{Binding SetFontScaleCommand}" CommandParameter="Medium" Content="M">
                                <attached:PseudoClass.Active><Binding Path="FontScale" Converter="{StaticResource StrEq}" ConverterParameter="Medium"/></attached:PseudoClass.Active>
                            </Button>
                            <Button Classes="chip" Command="{Binding SetFontScaleCommand}" CommandParameter="Large" Content="L">
                                <attached:PseudoClass.Active><Binding Path="FontScale" Converter="{StaticResource StrEq}" ConverterParameter="Large"/></attached:PseudoClass.Active>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Appearance_SidebarWidth_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_SidebarWidth_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="chip" Command="{Binding SetSidebarWidthCommand}" CommandParameter="Narrow" Content="{loc:Loc Settings_Appearance_Width_Narrow}">
                                <attached:PseudoClass.Active><Binding Path="SidebarWidth" Converter="{StaticResource StrEq}" ConverterParameter="Narrow"/></attached:PseudoClass.Active>
                            </Button>
                            <Button Classes="chip" Command="{Binding SetSidebarWidthCommand}" CommandParameter="Normal" Content="{loc:Loc Settings_Appearance_Width_Normal}">
                                <attached:PseudoClass.Active><Binding Path="SidebarWidth" Converter="{StaticResource StrEq}" ConverterParameter="Normal"/></attached:PseudoClass.Active>
                            </Button>
                            <Button Classes="chip" Command="{Binding SetSidebarWidthCommand}" CommandParameter="Wide" Content="{loc:Loc Settings_Appearance_Width_Wide}">
                                <attached:PseudoClass.Active><Binding Path="SidebarWidth" Converter="{StaticResource StrEq}" ConverterParameter="Wide"/></attached:PseudoClass.Active>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Appearance_CompactMode_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Appearance_CompactMode_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CompactMode, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>