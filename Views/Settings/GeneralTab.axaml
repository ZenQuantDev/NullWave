<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="NullWave.Views.Settings.GeneralTab"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <!--  Behaviour  -->
            <TextBlock Classes="section-label" Text="BEHAVIOUR" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Auto-fetch metadata"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Fetches title and artist from Last.fm when a URL is pasted.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Fetch title and artist when a URL is pasted"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding AutoFetchMetadata, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Auto-play next track"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Automatically play the next track when one finishes"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Download when added"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Download audio immediately when a URL is added to the library"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding DownloadOnAdd, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Scrobble to Last.fm"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="Submits plays to Last.fm when a track passes the threshold below. Requires a Last.fm API key.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Submit plays to Last.fm (requires API key)"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding ScrobbleToLastFm, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!--  Scrobble Threshold  -->
            <TextBlock Classes="section-label" Text="SCROBBLE THRESHOLD" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScrobbleThresholdDisplay}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Last.fm's own rule is 50% or 4 minutes, whichever comes first"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="0.1" Maximum="0.9"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ScrobbleThreshold, Mode=TwoWay}"
                            IsEnabled="{Binding ScrobbleToLastFm}"/>
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <TextBlock Grid.Column="0" Text="10%" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeXs}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="30%" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeXs}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="50%" Foreground="{StaticResource BrushAccent}"    FontSize="{StaticResource FontSizeXs}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="70%" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeXs}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="90%" Foreground="{StaticResource BrushTextMuted}" FontSize="{StaticResource FontSizeXs}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Skip Penalty  -->
            <TextBlock Classes="section-label" Text="SKIP PENALTY" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Early-skip window"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <Button Classes="help-btn"
                                        ToolTip.Tip="If you skip a track within this many seconds of it starting, it gets a skip penalty mark.">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Skipping within this window adds a penalty to the track"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SkipWindowOptions}"
                                  SelectedItem="{Binding SkipPenaltyWindowSeconds, Mode=TwoWay}"
                                  MinWidth="110"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Penalty cap"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Tracks reaching this many penalties are excluded from Smart Shuffle"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SkipPenaltyCapOptions}"
                                  SelectedItem="{Binding SkipPenaltyCap, Mode=TwoWay}"
                                  MinWidth="110"
                                  VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!--  Download Directory  -->
            <TextBlock Classes="section-label" Text="DOWNLOAD DIRECTORY" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Where downloaded audio files are saved"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding DownloadDirectory, Mode=TwoWay}"
                                 PlaceholderText="~/.nullwave/downloads"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="Browse..."
                                Command="{Binding BrowseDownloadDirCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>