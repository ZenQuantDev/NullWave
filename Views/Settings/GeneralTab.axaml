<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.GeneralTab"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="0">

            <!-- LANGUAGE SELECTOR CARD -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_General_Section_Language}" Margin="0,0,0,12"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Settings_General_Language_Title}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{DynamicResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc Settings_General_Language_Desc}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeSm}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Key}"
                                  DisplayMemberBinding="{Binding Value}"
                                  MinWidth="200"
                                  VerticalAlignment="Center"/>

                        <Button Classes="primary"
                                Content="{loc:Loc Settings_General_Language_Confirm}"
                                Command="{Binding ApplyLanguageCommand}"
                                IsVisible="{Binding IsLanguageApplyVisible}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BEHAVIOUR SECTION -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_General_Section_Behaviour}" Margin="0,24,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_General_AutoFetchMetadata_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_General_AutoFetchMetadata_Tooltip}">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_General_AutoFetchMetadata_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoFetchMetadata, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_General_AutoPlayNext_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_General_AutoPlayNext_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPlayNext, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_General_DownloadOnAdd_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_General_DownloadOnAdd_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DownloadOnAdd, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_General_Scrobble_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_General_Scrobble_Tooltip}">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_General_Scrobble_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScrobbleToLastFm, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SCROBBLE THRESHOLD -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_General_Section_ScrobbleThreshold}" Margin="0,24,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding ScrobbleThresholdDisplay}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_General_ScrobbleThreshold_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="0.1" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding ScrobbleThreshold, Mode=TwoWay}" IsEnabled="{Binding ScrobbleToLastFm}"/>
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <TextBlock Grid.Column="0" Text="10%" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="30%" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="50%" Foreground="{StaticResource BrushAccent}" FontSize="{DynamicResource FontSizeXs}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="70%" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="90%" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SKIP PENALTY -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_General_Section_SkipPenalty}" Margin="0,24,0,12"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_General_SkipWindow_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_General_SkipWindow_Tooltip}">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_General_SkipWindow_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SkipWindowOptions}" SelectedItem="{Binding SkipPenaltyWindowSeconds, Mode=TwoWay}" MinWidth="110" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_General_PenaltyCap_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_General_PenaltyCap_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SkipPenaltyCapOptions}" SelectedItem="{Binding SkipPenaltyCap, Mode=TwoWay}" MinWidth="110" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- EXPERIMENTAL FEATURES (Moved from Advanced) -->
            <TextBlock Classes="section-label" Text="Preview Features" Foreground="{StaticResource BrushAmber}" Margin="0,24,0,12"/>
            <Border Classes="settings-card" BorderBrush="{StaticResource BrushAmberDim}">
                <StackPanel Spacing="16">
                    <TextBlock Text="🧪 Enable features that are still under active development. These may change, exhibit visual glitches, or undergo performance tuning." 
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Enable Experimental Features" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="Unlocks the In-App Log Viewer, P2P Track Sharing, and other in-development tools." Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableExperimentalFeatures, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>