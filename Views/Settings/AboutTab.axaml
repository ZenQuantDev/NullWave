<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="NullWave.Views.Settings.AboutTab"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <!--  Branding  -->
            <Border Classes="settings-card">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                        <material:MaterialIcon Kind="Waveform"
                                               Width="48" Height="48"
                                               Foreground="{StaticResource BrushAccent}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NullWave"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="28"
                                       FontWeight="Black"
                                       LetterSpacing="1"/>
                            <TextBlock Text="Personal music organizer"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Version"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeBody}"/>
                            <TextBlock Text="{Binding CurrentVersion}"
                                       Foreground="{StaticResource BrushAccentHover}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource BrushBorder}"/>
                        <TextBlock Text="Open Source · Fedora Linux"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeBody}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Stack  -->
            <TextBlock Classes="section-label" Text="BUILT WITH" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text=".NET 8 + C#" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Avalonia UI 12" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="LibVLCSharp" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="SQLite-net-pcl" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="yt-dlp" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="TagLib#" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Serilog" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Material.Icons.Avalonia" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Links  -->
            <TextBlock Classes="section-label" Text="LINKS" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="github.com/Alexsandrgardaphadze/NullWave"
                               Foreground="{StaticResource BrushAccentHover}"
                               FontSize="{StaticResource FontSizeBody}"
                               Cursor="Hand"/>
                    <TextBlock Text="Issues, feature requests, and contributions welcome."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>