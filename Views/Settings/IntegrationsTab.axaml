<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:pvm="using:NullWave.ViewModels.Settings"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.IntegrationsTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <!-- CORE SERVICES (Formerly Plugins Tab) -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Integrations_CoreServices}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding PluginRows}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:PluginRowViewModel">
                        <Border Classes="settings-card" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusDotBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding !IsBusy, Mode=OneWay}" Click="OnPluginToggleClick" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- PROVIDER ROUTING (Formerly Sources Tab) -->
            <TextBlock Text="{loc:Loc Settings_Integrations_ProviderRouting}" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,4"/>
            <TextBlock Text="{loc:Loc Settings_Integrations_ProviderRouting_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding Sources.KindGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:SourceKindGroupViewModel">
                        <Border Classes="settings-card" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource BrushSurface2}" CornerRadius="{StaticResource RadiusFull}" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding IsSingleActive}">
                                        <TextBlock Text="{loc:Loc Settings_Integrations_Single}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </Border>
                                    <Border Background="{StaticResource BrushAccentDim}" CornerRadius="{StaticResource RadiusFull}" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding !IsSingleActive}">
                                        <TextBlock Text="{loc:Loc Settings_Integrations_Multi}" FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                                
                                <Border Background="{StaticResource BrushAmberDim}" CornerRadius="{StaticResource RadiusSm}" Padding="8,4" IsVisible="{Binding PairingMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Lock" Width="14" Height="14" Foreground="{StaticResource BrushAmber}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PairingMessage}" Foreground="{StaticResource BrushAmber}" FontSize="{DynamicResource FontSizeXs}"/>
                                    </StackPanel>
                                </Border>

                                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" IsVisible="{Binding IsSingleActive}" HorizontalAlignment="Stretch" MinHeight="36">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="pvm:SourceRowViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="{DynamicResource FontSizeSm}"/>
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                                </StackPanel>
                                                <material:MaterialIcon Grid.Column="1" Kind="CheckCircle" Width="16" Height="16" Foreground="{StaticResource BrushGreen}" IsVisible="{Binding IsActive}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ItemsControl ItemsSource="{Binding Providers}" IsVisible="{Binding !IsSingleActive}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pvm:SourceRowViewModel">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BrushSurface2}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeSm}" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>