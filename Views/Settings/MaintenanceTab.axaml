<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.MaintenanceTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="0">

            <!-- DIAGNOSTICS (Moved from Advanced) -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Diagnostics}" Margin="{StaticResource MarginSectionLabel}"/>
            <Border Classes="settings-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Loc Settings_Maintenance_VerboseLogging}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_VerboseLogging_Tooltip}">
                                <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding LoggingModeLabel}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerboseLogging}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- METADATA ENGINE -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Section_Metadata}" Margin="{StaticResource Margin2xl}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <TextBlock Text="{loc:Loc Settings_Maintenance_AutoClean_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_AutoClean_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCleanMetadata}" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- GATED: Force Clean Titles -->
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}" IsVisible="{Binding IsExperimentalModeActive}"/>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsExperimentalModeActive}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_ForceClean_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushAmberDim}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_Appearance_ExperimentalBadge}" FontSize="{DynamicResource FontSizeXs}" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_ForceClean_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_ForceClean_Button}" Command="{Binding ForceCleanTitlesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- LIBRARY HEALTH -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Section_Health}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Repair_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Repair_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Repair_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Repair_Button}" Command="{Binding RepairPathsCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    
                    <!-- GATED: Verify Links -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsExperimentalModeActive}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Verify_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushAmberDim}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_Appearance_ExperimentalBadge}" FontSize="{DynamicResource FontSizeXs}" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Verify_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Verify_Button}" Command="{Binding VerifyLinksCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    
                    <!-- GATED: Reimport Assets -->
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}" IsVisible="{Binding IsExperimentalModeActive}"/>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsExperimentalModeActive}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Reimport_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushAmberDim}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_Appearance_ExperimentalBadge}" FontSize="{DynamicResource FontSizeXs}" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Reimport_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Reimport_Button}" Command="{Binding ReimportAssetsCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DATA CLEANUP -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Section_Cleanup}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Sweep_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Sweep_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Sweep_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Content="{loc:Loc Settings_Maintenance_Preview}" Command="{Binding PreviewOrphanedFilesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                            <Button Classes="danger" Content="{loc:Loc Settings_Maintenance_Sweep_Button}" Command="{Binding SweepOrphanedFilesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Dedupe_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Dedupe_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Dedupe_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Content="{loc:Loc Settings_Maintenance_Preview}" Command="{Binding PreviewDuplicatesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                            <Button Classes="danger" Content="{loc:Loc Settings_Maintenance_Remove_Button}" Command="{Binding RemoveDuplicatesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- GATED: Merge Similar Artists -->
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}" IsVisible="{Binding IsExperimentalModeActive}"/>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsExperimentalModeActive}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Merge_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushAmberDim}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_Appearance_ExperimentalBadge}" FontSize="{DynamicResource FontSizeXs}" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Merge_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Merge_Button}" Command="{Binding MergeSimilarArtistsCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- METADATA & FILE SYNC -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Section_Sync}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Resync_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Resync_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Resync_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Resync_Button}" Command="{Binding ForceMetaResyncCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    
                    <!-- GATED: Sync Files -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsExperimentalModeActive}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_SyncFiles_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushAmberDim}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_Appearance_ExperimentalBadge}" FontSize="{DynamicResource FontSizeXs}" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_SyncFiles_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Content="{loc:Loc Settings_Maintenance_Preview}" Command="{Binding PreviewSyncFilesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                            <Button Classes="secondary" Content="{loc:Loc Settings_Maintenance_Sync_Button}" Command="{Binding SyncFilesCommand}" IsEnabled="{Binding !IsRepairing}"/>
                        </StackPanel>
                    </Grid>
                    
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Backfill_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Backfill_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Backfill_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Backfill_Button}" Command="{Binding RequestBackfillDurationsCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DATA SAFETY & BACKUPS -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Section_Safety}" Margin="{StaticResource Margin2xl}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <TextBlock Text="{loc:Loc Settings_Maintenance_AutoBackup_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_AutoBackup_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoBackups}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}" IsVisible="{Binding EnableAutoBackups}"/>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableAutoBackups}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <TextBlock Text="{loc:Loc Settings_Maintenance_BackupRetention_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_BackupRetention_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BackupRetentionOptions}" SelectedItem="{Binding BackupRetentionCount}" VerticalAlignment="Center" MinWidth="80"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Restore_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Restore_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Restore_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Restore_Button}" Command="{Binding RestoreDatabaseCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CACHE & DATABASE -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_Section_Cache}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Thumbs_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Thumbs_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Thumbs_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Thumbs_Button}" Command="{Binding ClearThumbnailsCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Cache_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Cache_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Cache_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Cache_Button}" Command="{Binding ClearYtDlpCacheCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_Optimize_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_Optimize_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_Optimize_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_Optimize_Button}" Command="{Binding VacuumDatabaseCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="{StaticResource MarginCardInternal}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Settings_Maintenance_SearchIndex_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Maintenance_SearchIndex_Tooltip}">
                                    <material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Maintenance_SearchIndex_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Maintenance_SearchIndex_Button}" Command="{Binding RebuildSearchIndexCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DATA & FOLDERS (Moved from Advanced) -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Maintenance_DataFolders}" Margin="{StaticResource Margin2xl}"/>
            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenData}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenData_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Advanced_OpenData}" Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenLogs}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_OpenLogs_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Advanced_OpenLogs}" Command="{Binding OpenLogsFolderCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="{StaticResource MarginSm}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Backup_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Backup_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="{loc:Loc Settings_Advanced_Backup_Button}" Command="{Binding BackupDatabaseCommand}" IsEnabled="{Binding !IsRepairing}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DANGER ZONE (Moved from Advanced) -->
            <TextBlock Classes="section-label" Text="{loc:Loc Settings_Advanced_Section_Danger}" Foreground="{StaticResource BrushRed}" Margin="{StaticResource Margin2xl}"/>
            <Border Classes="settings-card" BorderBrush="{StaticResource BrushRed}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteKeys_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteKeys_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_DeleteKeys_Button}" Command="{Binding DeleteApiKeysCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteLogs_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_DeleteLogs_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_DeleteLogs_Button}" Command="{Binding DeleteLogsCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Reset_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Reset_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_Reset_Button}" Command="{Binding ResetPreferencesCommand}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BrushRedDim}" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Advanced_Wipe_Title}" Foreground="{StaticResource BrushRed}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Loc Settings_Advanced_Wipe_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="{loc:Loc Settings_Advanced_Wipe_Button}" Command="{Binding DeleteEverythingCommand}" Margin="16,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="BottomSpacer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>