<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.SmartSortingTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="0">

            <!-- Master AI switch -->
            <Border Classes="settings-card" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <material:MaterialIcon Kind="Brain" Width="20" Height="20" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Settings_Smart_Master_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Smart_Master_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AIFeaturesEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Dimmed wrapper when AI is off -->
            <StackPanel Spacing="0" IsEnabled="{Binding AIFeaturesEnabled}">
                <StackPanel.Styles>
                    <Style Selector="StackPanel:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
                </StackPanel.Styles>

                <!-- Local AI -->
                <TextBlock Classes="section-label" Text="{loc:Loc Settings_Smart_Section_LocalAI}" Margin="0,0,0,12"/>
                <Border Classes="settings-card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{Binding AIStatusDotBrush}"/>
                                <TextBlock Text="{Binding AIStatusLabel}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AIStatusDescription}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}" Margin="0,4,0,0">
                                <ProgressBar Value="{Binding ModelDownloadProgress}" Maximum="100" Height="4"/>
                                <TextBlock Text="{Binding ModelDownloadStatus}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="primary" Content="{Binding AIToggleButtonLabel}" Command="{Binding ToggleAIServiceCommand}" IsEnabled="{Binding !IsDownloadingModel}" MinWidth="130" HorizontalContentAlignment="Center"/>
                            <Button Classes="secondary" Content="{loc:Loc Settings_Smart_DownloadModel}" Command="{Binding DownloadModelCommand}" IsEnabled="{Binding !IsDownloadingModel}" MinWidth="130" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding HardwareInfo}" Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="secondary" Content="{loc:Loc Settings_Smart_Redetect}" Command="{Binding DetectHardwareCommand}" IsEnabled="{Binding !IsDetectingHardware}"/>
                            <Border Background="{StaticResource BrushElevated}" CornerRadius="{StaticResource RadiusMd}" Padding="10,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon Kind="Flash" Width="14" Height="14" Foreground="{StaticResource BrushAmber}"/>
                                    <TextBlock Text="{Binding PowerStateLabel}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Model -->
                <TextBlock Classes="section-label" Text="{loc:Loc Settings_Smart_Section_Model}"/>
                <Border Classes="settings-card">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Smart_ActiveModel_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Settings_Smart_ActiveModel_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AIModelOptions}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" MinWidth="180" MaxWidth="240" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Classes="separator"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Smart_LocalInference_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Settings_Smart_LocalInference_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseLocalAI, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="settings-banner">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc Settings_Smart_Guide_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Smart_Guide_Tiny}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Settings_Smart_Guide_Tiny_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Smart_Guide_Small}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Settings_Smart_Guide_Small_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Smart_Guide_Medium}" Foreground="{StaticResource BrushAccentHover}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Settings_Smart_Guide_Medium_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Smart_Guide_Large}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Settings_Smart_Guide_Large_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Power-aware switching -->
                <TextBlock Classes="section-label" Text="{loc:Loc Settings_Smart_Section_Power}"/>
                <Border Classes="settings-card">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Loc Settings_Smart_PowerSwitch_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                    <Button Classes="help-btn" ToolTip.Tip="{loc:Loc Settings_Smart_PowerSwitch_Tooltip}"><material:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/></Button>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Settings_Smart_PowerSwitch_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPowerModelSwitch, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Classes="separator"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon Kind="BatteryMedium" Width="16" Height="16" Foreground="{StaticResource BrushAmber}"/>
                                    <TextBlock Text="{loc:Loc Settings_Smart_Battery_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Settings_Smart_Battery_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AIModelOptions}" SelectedItem="{Binding BatteryModel, Mode=TwoWay}" MinWidth="180" MaxWidth="240" VerticalAlignment="Center" IsEnabled="{Binding AutoPowerModelSwitch}"/>
                        </Grid>
                        <Border Classes="separator"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon Kind="Flash" Width="16" Height="16" Foreground="{StaticResource BrushGreen}"/>
                                    <TextBlock Text="{loc:Loc Settings_Smart_Plugged_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Settings_Smart_Plugged_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AIModelOptions}" SelectedItem="{Binding PerformanceModel, Mode=TwoWay}" MinWidth="180" MaxWidth="240" VerticalAlignment="Center" IsEnabled="{Binding AutoPowerModelSwitch}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- External AI tagging -->
                <TextBlock Classes="section-label" Text="{loc:Loc Settings_Smart_Section_External}"/>
                <Border Classes="settings-card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Settings_Smart_External_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Smart_External_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Smart_ExportFormat}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBlock Text="{loc:Loc Settings_Smart_ExportFormat_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ExportFormatOptions}" SelectedItem="{Binding ExportFormat, Mode=TwoWay}" MinWidth="140" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,16,*">
                            <Button Grid.Column="0" Classes="secondary" Command="{Binding ExportUntaggedTracksCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="Export" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:Loc Settings_Smart_ExportBtn}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="secondary" Command="{Binding ImportAiTagsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="Import" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:Loc Settings_Smart_ImportBtn}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding ExternalAIStatus}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap" IsVisible="{Binding ExternalAIStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <!-- Smart Shuffle -->
                <TextBlock Classes="section-label" Text="{loc:Loc Settings_Smart_Section_Shuffle}"/>
                <Border Classes="settings-card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_Smart_Confidence_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Settings_Smart_Confidence_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AIConfidenceOptions}" SelectedItem="{Binding AIConfidenceThreshold, Mode=TwoWay}" MinWidth="140" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Weather & Mood Mix -->
                <TextBlock Classes="section-label" Text="{loc:Loc Settings_Smart_Section_Weather}"/>
                <Border Classes="settings-card">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Loc Settings_Smart_Lat}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBox Text="{Binding Latitude, Mode=TwoWay}" PlaceholderText="{loc:Loc Settings_Smart_Lat_Placeholder}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="{loc:Loc Settings_Smart_Lon}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBox Text="{Binding Longitude, Mode=TwoWay}" PlaceholderText="{loc:Loc Settings_Smart_Lon_Placeholder}"/>
                            </StackPanel>
                        </Grid>
                        <Border Classes="separator"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Smart_AutoMood_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Settings_Smart_AutoMood_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoGenerateMoodPlaylist, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Classes="separator"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Smart_RefreshInterval_Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Settings_Smart_RefreshInterval_Desc}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MoodRefreshOptions}" SelectedItem="{Binding MoodRefreshInterval, Mode=TwoWay}" MinWidth="140" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="settings-banner">
                    <TextBlock Text="{loc:Loc Settings_Smart_Weather_Banner}" Foreground="{StaticResource BrushAccentHover}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Button Classes="primary" Content="{loc:Loc Settings_Smart_GenNow}" Command="{Binding GenerateMoodPlaylistCommand}"/>
                    <Button Classes="secondary" Content="{loc:Loc Settings_Smart_GenTags}" Command="{Binding GenerateTagMoodPlaylistCommand}"/>
                    <Button Classes="secondary" Content="{loc:Loc Settings_Smart_RefreshWeather}" Command="{Binding RefreshWeatherCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding MoodPlaylistStatus}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" Margin="0,12,0,0" TextWrapping="Wrap" IsVisible="{Binding MoodPlaylistStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Border Classes="BottomSpacer"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>