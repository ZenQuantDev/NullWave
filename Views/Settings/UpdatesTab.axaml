<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:pvm="using:NullWave.ViewModels.Settings"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.Settings.UpdatesTab"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse.dot"><Setter Property="Fill" Value="{StaticResource BrushTextMuted}"/></Style>
    <Style Selector="Ellipse.dot.good"><Setter Property="Fill" Value="{StaticResource BrushGreen}"/></Style>
    <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{StaticResource BrushAmber}"/></Style>
    <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="{StaticResource BrushRed}"/></Style>
  </UserControl.Styles>
  <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="0">
      <TextBlock Classes="section-label" Text="{loc:Loc Settings_Updates_Section_App}" Margin="{StaticResource MarginSectionLabel}"/>
      <Border Classes="settings-card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4" Margin="{StaticResource MarginCardInternal}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Loc Settings_Updates_CurrentVersion}"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                <TextBlock Text="{Binding CurrentVersion}"
                           Foreground="{StaticResource BrushTextPrimary}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Text="{Binding UpdateStatus}"
                         Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeSm}"/>
              <TextBlock Text="{Binding LastCheckText}"
                         Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"
                         IsVisible="{Binding HasLastCheck}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <Button Classes="primary" Content="{loc:Loc Settings_Updates_Check}"
                      Command="{Binding CheckForUpdateCommand}"
                      IsEnabled="{Binding CanCheckUpdate}"
                      IsVisible="{Binding IsAppInstalled}"/>
              <Button Classes="ghost" Content="{loc:Loc Settings_Updates_OpenRelease}"
                      Command="{Binding OpenReleasePageCommand}"
                      IsVisible="{Binding UpdateAvailable}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"
                       Height="4" IsVisible="{Binding IsStagingUpdate}"/>
          <Border Background="{StaticResource BrushAccentDim}" CornerRadius="{StaticResource RadiusMd}"
                  Padding="14,12" IsVisible="{Binding UpdateAvailable}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Loc Settings_Updates_NewVersion}"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"/>
                <TextBlock Text="{Binding LatestVersion}"
                           Foreground="{StaticResource BrushAccentHover}" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{loc:Loc Settings_Updates_Download}"
                        Command="{Binding DownloadUpdateCommand}"
                        IsEnabled="{Binding !IsStagingUpdate}"
                        IsVisible="{Binding !UpdateStaged}"
                        FontSize="{DynamicResource FontSizeSm}" Padding="12,6"/>
                <Button Classes="primary" Content="{loc:Loc Settings_Updates_Restart}"
                        Command="{Binding RestartToUpdateCommand}"
                        IsVisible="{Binding UpdateStaged}"
                        FontSize="{DynamicResource FontSizeSm}" Padding="12,6"/>
              </StackPanel>
              <TextBlock Text="{loc:Loc Settings_Updates_Hint}"
                         Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- FIX: Added Margin for consistent spacing with other tabs -->
      <TextBlock Classes="section-label" Text="{loc:Loc Settings_Updates_Section_Deps}" Margin="{StaticResource Margin2xl}"/>
      <Border Classes="settings-card">
        <StackPanel Spacing="8">
          <Button Classes="secondary" Content="{loc:Loc Settings_Updates_CheckAll}"
                  Command="{Binding CheckDependenciesCommand}"
                  IsEnabled="{Binding !IsCheckingDeps}"
                  HorizontalAlignment="Left"/>
          <ItemsControl ItemsSource="{Binding Dependencies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:DependencyRowViewModel">
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}" Padding="0,10">
                  <Grid ColumnDefinitions="110,Auto,*,Auto">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Grid.Column="1" Classes="dot" Classes.good="{Binding IsGood}"
                             Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"
                             Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSm}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Classes="primary" Content="{Binding ActionLabel}"
                            Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}"
                            FontSize="{DynamicResource FontSizeSm}" Padding="12,6"/>
                    <TextBlock Grid.Column="3" Text="{Binding Note}" IsVisible="{Binding ShowNote}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="BottomSpacer"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>