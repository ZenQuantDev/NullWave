<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             x:Class="NullWave.Views.Settings.UpdatesTab"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="20">

            <TextBlock Classes="section-label" Text="NULLWAVE" Margin="0"/>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Current version:"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text="{Binding CurrentVersion}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="{StaticResource FontSizeSm}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <Button Classes="primary"
                            Content="Check for updates"
                            Command="{Binding CheckForUpdateCommand}"
                            IsEnabled="{Binding !IsCheckingUpdate}"/>
                    <Button Classes="ghost"
                            Content="Open release page"
                            Command="{Binding OpenReleasePageCommand}"
                            IsVisible="{Binding UpdateAvailable}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BrushSurface2}"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="14,12"
                    IsVisible="{Binding UpdateAvailable}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="New version available:"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"/>
                        <TextBlock Text="{Binding LatestVersion}"
                                   Foreground="{StaticResource BrushAccentHover}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="NullWave does not auto-update. Visit the release page to download manually."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{StaticResource FontSizeXs}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Separator Background="{StaticResource BrushBorder}"/>
            <TextBlock Classes="section-label" Text="DEPENDENCIES" Margin="0"/>

            <Button Classes="secondary"
                    Content="Check all dependencies"
                    Command="{Binding CheckDependenciesCommand}"
                    HorizontalAlignment="Left"/>

            <!-- Dependency rows -->
            <Border Background="{StaticResource BrushSurface2}"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="14,10">
                <StackPanel Spacing="12">

                    <Grid ColumnDefinitions="120,*,Auto">
                        <TextBlock Grid.Column="0" Text="yt-dlp"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding YtDlpStatus}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Classes="primary"
                                Content="Update"
                                Command="{Binding UpdateYtDlpCommand}"
                                IsEnabled="{Binding !IsUpdatingYtDlp}"
                                FontSize="{StaticResource FontSizeSm}"
                                Padding="12,6"/>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}"/>

                    <Grid ColumnDefinitions="120,*,Auto">
                        <TextBlock Grid.Column="0" Text="VLC"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VlcStatus}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="system package"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}"/>

                    <Grid ColumnDefinitions="120,*,Auto">
                        <TextBlock Grid.Column="0" Text="FFmpeg"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FfmpegStatus}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="system package"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}"/>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text=".NET"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DotNetStatus}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
