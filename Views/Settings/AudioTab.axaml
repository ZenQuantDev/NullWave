<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             x:Class="NullWave.Views.Settings.AudioTab"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <TextBlock Classes="section-label" Text="DOWNLOAD SETTINGS" Margin="0,0,0,12"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Audio format"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Preferred container for downloaded streams"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AudioFormatOptions}"
                                  SelectedItem="{Binding AudioFormat, Mode=TwoWay}"
                                  MinWidth="130"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Audio quality"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Bitrate for extraction — 'best' grabs the highest available"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{StaticResource FontSizeSm}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AudioQualityOptions}"
                                  SelectedItem="{Binding AudioQuality, Mode=TwoWay}"
                                  MinWidth="130"
                                  VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <Border Background="{StaticResource BrushSurface2}"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="14,12">
                <TextBlock Text="Format and quality settings apply to new downloads. Existing files are not re-encoded."
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeXs}"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>