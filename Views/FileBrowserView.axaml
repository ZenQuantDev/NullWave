<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:fs="using:NullWave.Models.FileSystem"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:converters="using:NullWave.Helpers.Converters"
             xmlns:loc="using:NullWave.Helpers.Localization"
             x:Class="NullWave.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">

  <UserControl.Resources>
    <converters:NodeTypeToIconConverter x:Key="NodeTypeToIcon"/>
    <converters:FileSizeConverter x:Key="FileSize"/>
    <converters:BoolToMaterialIconKindConverter x:Key="BoolToIconKind"/>
    <converters:BoolToBrushConverter x:Key="ShowHiddenBrush"
        TrueBrush="{StaticResource BrushAccent}" FalseBrush="{StaticResource BrushTextMuted}"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.fb-row-actions">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.fb-row-actions">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.fb-row-actions">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Window.effects-minimal Border.fb-row-actions">
      <Setter Property="Transitions" Value="{x:Null}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Row 0: navigation + address bar + options flyout -->
    <Border Grid.Row="0" Classes="chrome" BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <Button Grid.Column="0" Classes="icon-btn" Command="{Binding GoBackCommand}"
                IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{loc:Loc Files_Back}">
          <material:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
        </Button>
        <Button Grid.Column="1" Classes="icon-btn" Command="{Binding GoForwardCommand}"
                IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{loc:Loc Files_Forward}">
          <material:MaterialIcon Kind="ArrowRight" Width="18" Height="18"/>
        </Button>
        <Button Grid.Column="2" Classes="icon-btn" Command="{Binding GoUpCommand}"
                IsEnabled="{Binding CanGoUp}" ToolTip.Tip="{loc:Loc Files_Up}">
          <material:MaterialIcon Kind="ArrowUp" Width="18" Height="18"/>
        </Button>

        <Panel Grid.Column="3" Margin="8,0" VerticalAlignment="Center">
          <Border IsVisible="{Binding !IsEditingPath}" Height="32" ClipToBounds="True"
                  Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="4,0">
            <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BreadcrumbSegment">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Classes="ghost" Padding="6,2" BorderThickness="0"
                              Content="{Binding Name}"
                              Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).NavigateSegmentCommand}"
                              CommandParameter="{Binding}"/>
                      <material:MaterialIcon Kind="ChevronRight" Width="14" Height="14"
                                             Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"
                                             IsVisible="{Binding !IsLast}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <TextBox x:Name="PathBox" Text="{Binding PathDraft, Mode=TwoWay}"
                   IsVisible="{Binding IsEditingPath}"
                   PlaceholderText="{loc:Loc Files_PathPlaceholder}"
                   KeyDown="OnPathEditorKeyDown"
                   LostFocus="OnPathEditorLostFocus"/>
        </Panel>

        <Button Grid.Column="4" Classes="icon-btn" Command="{Binding StartEditPathCommand}"
                IsVisible="{Binding !IsEditingPath}" ToolTip.Tip="{loc:Loc Files_EditPath_Tooltip}">
          <material:MaterialIcon Kind="Pencil" Width="16" Height="16"/>
        </Button>
        <Button Grid.Column="5" Classes="icon-btn" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{loc:Loc Files_Refresh}">
          <material:MaterialIcon Kind="Refresh" Width="18" Height="18"/>
        </Button>

        <Button Grid.Column="6" Classes="icon-btn" ToolTip.Tip="{loc:Loc Files_Options}">
          <material:MaterialIcon Kind="Tune" Width="18" Height="18"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="12" Width="300" Margin="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Loc Files_ShowHidden}" VerticalAlignment="Center"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHidden, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Loc Files_SearchRecursive_Tooltip}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SearchRecursive, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SearchRecursive}">
                  <TextBlock Text="{loc:Loc Files_SearchDepth}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding SearchDepthOptions}"
                            SelectedItem="{Binding SearchDepth}" MinWidth="70"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BrushBorder}"/>
                <Button Classes="ghost" Command="{Binding TogglePinCurrentFolderCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon Kind="{Binding IsCurrentPinned, Converter={StaticResource BoolToIconKind}, ConverterParameter='Pin, PinOutline'}"
                                           Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc Files_PinCurrent}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Row 1: places on the left, sort on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Places}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="fs:FileSystemNode">
              <Button Classes="chip" Classes.active="{Binding IsCurrentPlace}"
                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).NavigateToCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <material:MaterialIcon Kind="{Binding Type, Converter={StaticResource NodeTypeToIcon}}"
                                         Width="14" Height="14" Foreground="{StaticResource BrushAccent}"/>
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSm}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
        <ComboBox ItemsSource="{Binding FileSortOptions}"
                  SelectedItem="{Binding SelectedSortOption}" MinWidth="140">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileSortOption">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="icon-btn" Command="{Binding ToggleFileSortDirectionCommand}"
                ToolTip.Tip="{loc:Loc Files_SortDirection_Tooltip}">
          <material:MaterialIcon Kind="{Binding FileSortIconKind}" Width="18" Height="18"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Row 2: column headers -->
    <Border Grid.Row="2" Classes="wallpaper-row-header" Padding="8,6,8,2">
      <Grid ColumnDefinitions="Auto,*,90,90,112">
        <Border Grid.Column="0" Width="{DynamicResource RowArtSize}" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Classes="section-label" Text="{loc:Loc Files_Header_Name}" Margin="0"/>
        <TextBlock Grid.Column="2" Classes="section-label" Text="{loc:Loc Files_Header_Length}" Margin="0" HorizontalAlignment="Center"/>
        <TextBlock Grid.Column="3" Classes="section-label" Text="{loc:Loc Files_Header_Size}" Margin="0" HorizontalAlignment="Right"/>
        <Border Grid.Column="4" Width="108"/>
      </Grid>
    </Border>

    <!-- Row 3: listing (wallpaper-visible again) -->
    <Grid Grid.Row="3" x:Name="ListingArea">
      <Grid.Transitions>
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/></Transitions>
      </Grid.Transitions>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                   Height="2" VerticalAlignment="Top"/>

      <ListBox x:Name="FileList" ItemsSource="{Binding CurrentNodes}"
               SelectedItem="{Binding SelectedNode}" SelectionMode="Multiple"
               Background="Transparent"
               DoubleTapped="OnListDoubleTapped" KeyDown="OnListKeyDown"
               SelectionChanged="OnListSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="fs:FileSystemNode">
            <Grid Classes="track-row" ColumnDefinitions="Auto,*,90,90,112" Margin="8,6">
              <Border Grid.Column="0" Width="{DynamicResource RowArtSize}" Height="{DynamicResource RowArtSize}"
                      CornerRadius="{StaticResource RadiusArt}" Background="{StaticResource BrushSurface2}"
                      ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,12,0">
                <material:MaterialIcon Kind="{Binding Type, Converter={StaticResource NodeTypeToIcon}}"
                                       Width="20" Height="20"
                                       Foreground="{StaticResource BrushAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <Border Background="{StaticResource BrushGreenDim}" CornerRadius="{StaticResource RadiusSm}"
                          Padding="6,1" IsVisible="{Binding IsInLibrary}">
                    <TextBlock Text="{loc:Loc Files_InLibrary}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{StaticResource BrushGreen}"/>
                  </Border>
                  <material:MaterialIcon Kind="Lock" Width="14" Height="14"
                                         Foreground="{StaticResource BrushAmber}" VerticalAlignment="Center"
                                         IsVisible="{Binding MetadataFailed}"
                                         ToolTip.Tip="{loc:Loc Files_MetadataUnavailable}"/>
                </StackPanel>
                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{DynamicResource FontSizeXs}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding IsAudio}"/>
              </StackPanel>

              <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{StaticResource BrushTextMuted}" Margin="16,0"
                         IsVisible="{Binding IsAudio}"/>
              <TextBlock Grid.Column="3" Text="{Binding Size, Converter={StaticResource FileSize}}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Foreground="{StaticResource BrushTextMuted}" Margin="0,0,16,0"
                         IsVisible="{Binding IsAudio}"/>

              <Border Grid.Column="4" Classes="fb-row-actions" IsVisible="{Binding IsAudio}">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                  <Button Classes="icon-btn sm" ToolTip.Tip="{loc:Loc Files_Play}"
                          Command="{Binding $parent[ListBox].((vm:FileBrowserViewModel)DataContext).PlayFileCommand}"
                          CommandParameter="{Binding}">
                    <material:MaterialIcon Kind="Play" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="icon-btn sm" ToolTip.Tip="{loc:Loc Files_Queue}"
                          Command="{Binding $parent[ListBox].((vm:FileBrowserViewModel)DataContext).AddToQueueCommand}"
                          CommandParameter="{Binding}">
                    <material:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16"/>
                  </Button>
                  <Button Classes="icon-btn sm" ToolTip.Tip="{loc:Loc Files_AddLibrary}"
                          Command="{Binding $parent[ListBox].((vm:FileBrowserViewModel)DataContext).AddToLibraryCommand}"
                          CommandParameter="{Binding}">
                    <material:MaterialIcon Kind="LibraryPlus" Width="16" Height="16"/>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Floating bulk action bar -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
              Background="{StaticResource BrushElevated}" BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusFull}" Padding="10,6"
              IsVisible="{Binding HasSelection}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding SelectionCountLabel}" VerticalAlignment="Center"
                     Foreground="{StaticResource BrushTextSecondary}" FontSize="{DynamicResource FontSizeXs}" Margin="4,0,6,0"/>
          <Button Classes="icon-btn" Command="{Binding BulkQueueCommand}" ToolTip.Tip="{loc:Loc Files_Bulk_Queue}">
            <material:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16"/>
          </Button>
          <Button Classes="icon-btn" Command="{Binding BulkImportCommand}" ToolTip.Tip="{loc:Loc Files_Bulk_Import}">
            <material:MaterialIcon Kind="LibraryPlus" Width="16" Height="16"/>
          </Button>
          <Button Classes="icon-btn" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="{loc:Loc Files_Bulk_Clear}">
            <material:MaterialIcon Kind="Close" Width="16" Height="16"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- States -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding IsEmpty}">
        <material:MaterialIcon Kind="FolderOpen" Width="48" Height="48"
                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc Files_EmptyFolder}" Foreground="{StaticResource BrushTextMuted}"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding IsSearchEmpty}">
        <material:MaterialIcon Kind="FileSearchOutline" Width="48" Height="48"
                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc Files_NoSearchResults}" Foreground="{StaticResource BrushTextMuted}"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding AccessDenied}">
        <material:MaterialIcon Kind="LockOutline" Width="48" Height="48"
                               Foreground="{StaticResource BrushAmber}" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc Files_AccessDenied}" Foreground="{StaticResource BrushTextMuted}"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding LoadFailed}">
        <material:MaterialIcon Kind="AlertCircleOutline" Width="48" Height="48"
                               Foreground="{StaticResource BrushAmber}" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc Files_LoadFailed}" Foreground="{StaticResource BrushTextMuted}"/>
      </StackPanel>
    </Grid>

    <!-- Row 4: info strip -->
    <Border Grid.Row="4" Classes="chrome" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
            Padding="16,10" IsVisible="{Binding SelectedNode.IsAudio, FallbackValue=False}">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding SelectedNode.Title}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SelectedNode.Artist}" Foreground="{StaticResource BrushTextMuted}"/>
        </StackPanel>
        <TextBlock Text="{Binding SelectedNode.Album}" Foreground="{StaticResource BrushTextMuted}"/>
        <TextBlock Text="{Binding SelectedNode.Details}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"/>
        <TextBlock Text="{Binding SelectedNode.Path}" Foreground="{StaticResource BrushTextMuted}" FontSize="{DynamicResource FontSizeXs}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedNode.Path}"/>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>