<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:views="using:NullWave.Views"
        x:Class="NullWave.Views.MoveToFolderDialog"
        Title="Move to Folder" Width="360" Height="400"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{StaticResource BrushBase}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="MOVE TO FOLDER" Margin="0,0,0,8"/>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,10,0,0">
            <Button Grid.Column="2" Classes="secondary" Content="Cancel" Click="OnCancel" Padding="16,8"/>
            <Button Grid.Column="4" Classes="primary" Content="Move" Click="OnOk" Padding="16,8"/>
        </Grid>
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
            <ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:FolderOption">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,6">
                            <material:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18"
                                    Foreground="{StaticResource BrushAmber}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>