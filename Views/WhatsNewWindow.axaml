<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NullWave.Views.Controls"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="NullWave.Views.WhatsNewWindow"
        Title="What's New in NullWave"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{DynamicResource BrushBase}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <!-- Header: icon + title only; the version line now lives inside ChangelogView -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
      <material:MaterialIcon Kind="PartyPopper" Width="24" Height="24"
                             Foreground="{DynamicResource BrushAccent}"
                             VerticalAlignment="Center"/>
      <TextBlock x:Name="TitleText" Text="What's New in NullWave"
                 FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource BrushTextPrimary}"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <Border Grid.Row="1"
            Background="{DynamicResource BrushSurface}"
            CornerRadius="{StaticResource RadiusMd}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            Padding="18,16">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <controls:ChangelogView/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Classes="primary" Content="Got it!" Click="OnCloseClick" Padding="24,8" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>