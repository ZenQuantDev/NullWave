<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:settings="using:NullWave.Views.Settings"
        xmlns:controls="using:NullWave.Views.Controls"
        xmlns:converters="using:NullWave.Helpers.Converters"
        xmlns:services="using:NullWave.Services"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:loc="using:NullWave.Helpers.Localization"
        x:Class="NullWave.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:Loc Settings_Window_Title}"
        Width="950" Height="680"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBase}"
        CanResize="True">
    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StrEq"/>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.settings-group-sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Margin" Value="8,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector=".collapsed Border.settings-group-sep">
            <Setter Property="Margin" Value="12,8"/>
        </Style>
        <Style Selector="TextBlock.settings-group-label">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,12,8,4"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector=".collapsed TextBlock.settings-group-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        
        <!-- Base art-tile styles -->
        <Style Selector="Border.art-tile">
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style Selector="Button.nav material|MaterialIcon">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Button.nav.active Border.art-tile">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
        </Style>

        <!-- Compact mode overrides -->
        <Style Selector=".collapsed Button.nav /template/ ContentPresenter,
                        .collapsed Button.nav:pointerover /template/ ContentPresenter,
                        .collapsed Button.nav:pressed /template/ ContentPresenter,
                        .collapsed Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector=".collapsed Button.nav Border.art-tile">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        </Style>
        <Style Selector=".collapsed Button.nav:pointerover Border.art-tile">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector=".collapsed Button.nav.active Border.art-tile">
            <Setter Property="Background" Value="{StaticResource BrushAccentDim}"/>
        </Style>
        <Style Selector=".collapsed Button.nav material|MaterialIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        </Style>
        <Style Selector=".collapsed Button.nav:pointerover material|MaterialIcon">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        </Style>
        <Style Selector=".collapsed Button.nav.active material|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
        </Style>

        <Style Selector="Border.success, Border.error, Border.warning, Border.info">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.success"><Setter Property="Background" Value="{DynamicResource BrushGreenDim}"/></Style>
        <Style Selector="Border.error"><Setter Property="Background" Value="{DynamicResource BrushRedDim}"/></Style>
        <Style Selector="Border.warning"><Setter Property="Background" Value="{DynamicResource BrushAmberDim}"/></Style>
        <Style Selector="Border.info"><Setter Property="Background" Value="{DynamicResource BrushBase}"/></Style>

        <Style Selector="Border.settings-navrail.collapsed Border.rail-header">
            <Setter Property="Padding" Value="0,16"/>
        </Style>
        <Style Selector="Border.settings-navrail.collapsed Button.nav">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Panel>
        <controls:WallpaperLayer/>
        <Border Classes="wallpaper-scrim"/>
        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0"
                    Classes="settings-navrail chrome"
                    Classes.collapsed="{Binding IsSettingsSidebarCollapsed}"
                    Width="{Binding SettingsSidebarWidth}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Classes="rail-header"
                            Height="{StaticResource SettingsHeaderHeight}"
                            Padding="20,0"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1">
                        <Panel>
                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSettingsSidebarExpanded}">
                                <Border Grid.Column="0" Width="28" Height="28"
                                        CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                                        Background="{StaticResource BrushAccentGradient}">
                                    <material:MaterialIcon Kind="Waveform" Width="16" Height="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="NullWave"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="{DynamicResource FontSizeBodyLarge}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{loc:Loc Settings_Header_Settings}"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeXs}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="icon-btn"
                                        Command="{Binding ToggleSettingsSidebarCommand}"
                                        ToolTip.Tip="Collapse sidebar" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="{Binding SettingsSidebarCollapseIconKind}" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                            <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding ToggleSettingsSidebarCommand}"
                                    ToolTip.Tip="Expand sidebar"
                                    IsVisible="{Binding IsSettingsSidebarCollapsed}">
                                <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                                        Background="{StaticResource BrushAccentGradient}">
                                    <material:MaterialIcon Kind="Waveform" Width="16" Height="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Panel>
                    </Border>
                    
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding CurrentVersion, StringFormat='NullWave v{0}'}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeXs}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                               
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8">
                        <Grid>
                            <StackPanel Margin="8,4,8,0" Spacing="3">
                                <TextBlock Classes="settings-group-label" Text="BASICS"/>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="General" ToolTip.Tip="{loc:Loc Settings_Nav_General}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=General}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="TuneVariant" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_General}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Appearance" ToolTip.Tip="{loc:Loc Settings_Nav_Appearance}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Appearance}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="Palette" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Appearance}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Audio" ToolTip.Tip="{loc:Loc Settings_Nav_Audio}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Audio}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="MusicNote" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Audio}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Downloads" ToolTip.Tip="{loc:Loc Settings_Nav_Downloads}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Downloads}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="Download" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Downloads}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Classes="settings-group-sep"/>
                                <TextBlock Classes="settings-group-label" Text="CONNECTIONS"/>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Integrations" ToolTip.Tip="{loc:Loc Settings_Nav_Integrations}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Integrations}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Panel>
                                                <Border Classes="art-tile">
                                                    <material:MaterialIcon Kind="Puzzle" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAmber}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                         Margin="0,5,5,0" IsVisible="{Binding IntegrationsNeedsAttention}"/>
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Integrations}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="ApiKeys" ToolTip.Tip="{loc:Loc Settings_Nav_ApiKeys}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=ApiKeys}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Panel>
                                                <Border Classes="art-tile">
                                                    <material:MaterialIcon Kind="Key" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAmber}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                         Margin="0,5,5,0" IsVisible="{Binding ApiKeysNeedsAttention}"/>
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_ApiKeys}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="SmartFeatures" ToolTip.Tip="{loc:Loc Settings_Nav_SmartFeatures}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=SmartFeatures}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="AutoFixHigh" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_SmartFeatures}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Classes="settings-group-sep"/>
                                <TextBlock Classes="settings-group-label" Text="SYSTEM"/>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Maintenance" ToolTip.Tip="{loc:Loc Settings_Nav_Maintenance}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Maintenance}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="Tools" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Maintenance}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Updates" ToolTip.Tip="{loc:Loc Settings_Nav_Updates}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Updates}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="Update" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Updates}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Classes="settings-group-sep"/>
                                <TextBlock Classes="settings-group-label" Text="INFO"/>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="About" ToolTip.Tip="{loc:Loc Settings_Nav_About}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=About}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="InformationOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_About}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="Help" ToolTip.Tip="{loc:Loc Settings_Nav_Help}" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Help}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="HelpCircle" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="{loc:Loc Settings_Nav_Help}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="3,*" IsVisible="{Binding IsDevMode}">
                                    <Button Grid.Column="1" Command="{Binding NavigateSettingsCommand}" CommandParameter="DevTools" ToolTip.Tip="Developer Tools" Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=DevTools}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Classes="art-tile">
                                                <material:MaterialIcon Kind="CodeTags" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="expand-only" Text="Developer" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsSettingsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <Canvas x:Name="SpineCanvas" IsHitTestVisible="False" ZIndex="10">
                                <Border x:Name="SpineBead" Width="3" Height="24" CornerRadius="0,2,2,0"
                                        Background="{DynamicResource BrushAccent}" Canvas.Left="8" Canvas.Top="-100">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Canvas.Top" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Classes="chrome"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Height="{StaticResource SettingsHeaderHeight}"
                        Padding="24,0">
                    <Panel>
                        <material:MaterialIcon Kind="{Binding CurrentSettingsPageIcon}" Width="120" Height="120" Opacity="0.05"
                                               HorizontalAlignment="Right" Margin="0,0,-12,0" IsHitTestVisible="False"
                                               Foreground="{StaticResource BrushAccent}"/>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSettingsPageTitle}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="{DynamicResource FontSizeXl}"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentSettingsPageDescription}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Panel>
                </Border>
                
                <TransitioningContentControl x:Name="PageHost" Grid.Row="1"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>
        
        <controls:ToastOverlayView VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30"
                                   IsVisible="{Binding Source={x:Static services:ToastService.Instance}, Path=SettingsHostActive}"/>
    </Panel>
</Window>