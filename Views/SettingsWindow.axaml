<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:settings="using:NullWave.Views.Settings"
        x:Class="NullWave.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="NullWave — Settings"
        Width="740" Height="620"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBase}"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="Settings"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="Bold"/>
                <TextBlock Text="Manage API keys, audio, updates, and preferences"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeSm}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Tab body ────────────────────────────────────────────────── -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="Background"   Value="Transparent"/>
                    <Setter Property="Foreground"   Value="{StaticResource BrushTextMuted}"/>
                    <Setter Property="FontSize"     Value="{StaticResource FontSizeBody}"/>
                    <Setter Property="Padding"      Value="16,12"/>
                    <Setter Property="Cursor"       Value="Hand"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground"   Value="{StaticResource BrushAccentHover}"/>
                </Style>
                <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                    <Setter Property="Background"   Value="{StaticResource BrushAccent}"/>
                </Style>
            </TabControl.Styles>

            <TabItem Header="General">
                <settings:GeneralTab/>
            </TabItem>

            <TabItem Header="API Keys">
                <settings:ApiKeysTab/>
            </TabItem>

            <TabItem Header="Audio">
                <settings:AudioTab/>
            </TabItem>

            <TabItem Header="Updates">
                <settings:UpdatesTab/>
            </TabItem>

            <TabItem Header="Advanced">
                <settings:AdvancedTab/>
            </TabItem>

            <TabItem Header="About">
                <settings:AboutTab/>
            </TabItem>

        </TabControl>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Keys stored encrypted at ~/.nullwave/keys.enc"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeXs}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="primary"
                        Content="Save API Keys"
                        Command="{Binding SaveKeysCommand}"/>
            </Grid>
        </Border>

    </Grid>
</Window>