<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:settings="using:NullWave.Views.Settings"
        xmlns:converters="using:NullWave.Helpers.Converters"
        xmlns:services="using:NullWave.Services"
        xmlns:models="using:NullWave.Models"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="NullWave.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="NullWave Configuration Desk"
        Width="950" Height="660"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBase}"
        CanResize="True">

    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StrEq"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.success, Border.error, Border.warning, Border.info">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.success">
            <Setter Property="Background" Value="{DynamicResource BrushGreenDim}"/>
        </Style>
        <Style Selector="Border.error">
            <Setter Property="Background" Value="{DynamicResource BrushRedDim}"/>
        </Style>
        <Style Selector="Border.warning">
            <Setter Property="Background" Value="{DynamicResource BrushAmberDim}"/>
        </Style>
        <Style Selector="Border.info">
            <Setter Property="Background" Value="{DynamicResource BrushBase}"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Grid ColumnDefinitions="220,*">
            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="20,24,20,20"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="Waveform"
                                                   Width="28" Height="28"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NullWave"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Settings"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeXs}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding CurrentVersion, StringFormat='System Node Build v{0}'}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeXs}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8">
                        <StackPanel Margin="8,4,8,0" Spacing="3">
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="General"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=General}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="TuneVariant" Width="16" Height="16"/>
                                    <TextBlock Text="General"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="Appearance"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Appearance}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="Palette" Width="16" Height="16"/>
                                    <TextBlock Text="Appearance"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="ApiKeys"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=ApiKeys}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="Key" Width="16" Height="16"/>
                                    <TextBlock Text="API Keys"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="Plugins"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Plugins}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="Puzzle" Width="16" Height="16"/>
                                    <TextBlock Text="Plugins"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="Audio"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Audio}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="MusicNote" Width="16" Height="16"/>
                                    <TextBlock Text="Audio"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="SmartFeatures"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=SmartFeatures}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="AutoFixHigh" Width="16" Height="16"/>
                                    <TextBlock Text="Smart Features"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="Maintenance"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Maintenance}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="Tools" Width="16" Height="16"/>
                                    <TextBlock Text="Maintenance"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="Updates"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Updates}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="Update" Width="16" Height="16"/>
                                    <TextBlock Text="Updates"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="Advanced"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Advanced}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="Cog" Width="16" Height="16"/>
                                    <TextBlock Text="Advanced"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateSettingsCommand}" CommandParameter="About"
                                    Classes="nav" Classes.active="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=About}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="InformationOutline" Width="16" Height="16"/>
                                    <TextBlock Text="About"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <settings:GeneralTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=General}"/>
                <settings:AppearanceTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Appearance}"/>
                <settings:ApiKeysTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=ApiKeys}"/>
                <settings:PluginsTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Plugins}"/>
                <settings:AudioTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Audio}"/>
                <settings:SmartSortingTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=SmartFeatures}"/>
                <settings:MaintenanceTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Maintenance}"/>
                <settings:UpdatesTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Updates}"/>
                <settings:AdvancedTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=Advanced}"/>
                <settings:AboutTab DataContext="{Binding}" IsVisible="{Binding CurrentSettingsPage, Converter={StaticResource StrEq}, ConverterParameter=About}"/>
            </Grid>
        </Grid>

        <!-- THE TOAST OVERLAY LAYER (visible only while Settings IS the active host) -->
        <StackPanel DataContext="{x:Static services:ToastService.Instance}"
                    x:DataType="services:ToastService"
                    IsVisible="{Binding SettingsHostActive}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30">
            <Button Content="Dismiss all" Classes="ghost" Padding="8,4"
                    HorizontalAlignment="Center" Margin="0,0,0,6"
                    IsVisible="{Binding ShowDismissAll}"
                    Command="{Binding DismissAllCommand}"/>
            <ItemsControl ItemsSource="{Binding ActiveNotifications}" IsHitTestVisible="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LiveNotification">
                        <Border Width="360" Margin="0,2"
                                Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="12" BoxShadow="0 4 20 0 #55000000" ClipToBounds="True"
                                PointerEntered="OnToastPointerEntered"
                                PointerExited="OnToastPointerExited">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Width="5" VerticalAlignment="Stretch" Background="{Binding NotificationColor}"/>
                                <StackPanel Grid.Column="1" Margin="14,12" Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Path Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0"
                                            Fill="{Binding NotificationColor}" Data="{Binding IconData}"
                                            Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Command="{Binding CloseCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="4"
                                                MinWidth="0" MinHeight="0" Cursor="Hand">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Opacity" Value="0.7"/>
                                                </Style>
                                            </Button.Styles>
                                            <material:MaterialIcon Kind="Close" Width="14" Height="14"
                                                                Foreground="{StaticResource BrushTextMuted}"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding Message}" FontSize="12"
                                            Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"
                                            Margin="23,0,0,2"/>
                                    <ProgressBar IsVisible="{Binding ShowProgressBar}" Value="{Binding ProgressValue}"
                                                IsIndeterminate="{Binding IsIndeterminate}" Height="4" Margin="23,2,0,2"
                                                CornerRadius="2" Background="{StaticResource BrushBorder}"
                                                Foreground="{Binding NotificationColor}"/>
                                    <Button IsVisible="{Binding ShowActionButton}" Command="{Binding ActionCommand}"
                                            Content="{Binding ActionButtonText}" HorizontalAlignment="Right"
                                            FontSize="{DynamicResource FontSizeXs}" Padding="10,4"
                                            Background="{StaticResource BrushSurface2}"
                                            Foreground="{StaticResource BrushTextPrimary}" CornerRadius="6"/>
                                    <StackPanel IsVisible="{Binding HasDetailedMessage}" Margin="23,2,0,0">
                                        <Button Command="{Binding ToggleExpandCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalAlignment="Left" Cursor="Hand">
                                            <Panel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsExpanded}">
                                                    <material:MaterialIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Show details" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsExpanded}">
                                                    <material:MaterialIcon Kind="ChevronUp" Width="14" Height="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Hide details" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Panel>
                                        </Button>
                                        <Border IsVisible="{Binding IsExpanded}" Margin="0,6,0,0" Padding="8"
                                                Background="{StaticResource BrushBase}" CornerRadius="6"
                                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding DetailedMessage}" FontSize="11"
                                                        Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Panel>
</Window>