<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NullWave.ViewModels"
        xmlns:settings="using:NullWave.Views.Settings"
        x:Class="NullWave.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="NullWave — Settings"
        Width="740" Height="660"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBase}"
        CanResize="True">

    <DockPanel>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="Settings"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="Bold"/>
                <TextBlock Text="Manage appearance, API keys, audio, and preferences"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="{StaticResource FontSizeSm}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Tab body (fills remaining space, scrolling handled per-tab) -->
        <TabControl Background="Transparent" Padding="0">
            <TabItem Header="General">    <settings:GeneralTab/>    </TabItem>
            <TabItem Header="Appearance"> <settings:AppearanceTab/> </TabItem>
            <TabItem Header="API Keys">   <settings:ApiKeysTab/>    </TabItem>
            <TabItem Header="Audio">      <settings:AudioTab/>      </TabItem>
            <TabItem Header="Updates">    <settings:UpdatesTab/>    </TabItem>
            <TabItem Header="Advanced">   <settings:AdvancedTab/>   </TabItem>
            <TabItem Header="About">      <settings:AboutTab/>      </TabItem>
        </TabControl>

    </DockPanel>
</Window>