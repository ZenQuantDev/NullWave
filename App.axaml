<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NullWave.ViewModels"
             xmlns:controls="using:NullWave.Views.Controls"
             xmlns:converters="using:NullWave.Helpers.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NullWave.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Globally available converters to prevent Flyout/Dialog KeyNotFoundExceptions -->
            <converters:BoolNegationConverter x:Key="BoolNegation"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NullWave/Themes/Colors.axaml"/>
                <ResourceInclude Source="avares://NullWave/Themes/Typography.axaml"/>
                <ResourceInclude Source="avares://NullWave/Themes/Shapes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://NullWave/Themes/ControlStyles.axaml"/>
        <materialIcons:MaterialIconStyles />
        
        <!-- Global Font Fallback for Non-English Characters -->
        <!-- TextBlock covers standalone text. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, Noto Sans, Microsoft YaHei, Apple Color Emoji, Segoe UI Emoji" />
        </Style>
        <!-- TemplatedControl covers text inside Buttons, TextBoxes, Labels, etc. 
             It automatically cascades down to their internal TextPresenters. -->
        <Style Selector="TemplatedControl">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, Noto Sans, Microsoft YaHei, Apple Color Emoji, Segoe UI Emoji" />
        </Style>
    </Application.Styles>
</Application>